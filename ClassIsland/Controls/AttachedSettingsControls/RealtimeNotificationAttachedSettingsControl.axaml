<ci:AttachedSettingsControlBase x:Class="ClassIsland.Controls.AttachedSettingsControls.RealtimeNotificationAttachedSettingsControl"
                                x:TypeArguments="attachedSettings:RealtimeNotificationAttachedSettings"
                                xmlns="https://github.com/avaloniaui"
                                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                                xmlns:ci="http://classisland.tech/schemas/xaml/core"
                                xmlns:local="using:ClassIsland.Controls.AttachedSettingsControls"
                                xmlns:attachedSettings="using:ClassIsland.Models.AttachedSettings"
                                xmlns:fa="using:FluentAvalonia.UI.Controls"
                                x:DataType="local:RealtimeNotificationAttachedSettingsControl"
                                x:CompileBindings="True">
    <UserControl.Styles>
        <Style Selector="WrapPanel > CheckBox">
            <Setter Property="Margin" Value="0 0 12 4" />
        </Style>
    </UserControl.Styles>
    <StackPanel Spacing="4"
                DataContext="{Binding $parent[local:RealtimeNotificationAttachedSettingsControl].Settings}"
                x:DataType="attachedSettings:RealtimeNotificationAttachedSettings">
        <TabControl Classes="compact" Padding="0">
            <TabItem Header="即将上课">
                <StackPanel Spacing="4">
                    <CheckBox Content="启用即将上课实时通知"
                              IsChecked="{Binding IsUpcomingClassRealtimeNotificationEnabled, Mode=TwoWay}" />
                    <ci:Field Label="提前提醒时长" Suffix="分钟">
                        <fa:FANumberBox Minimum="0" Maximum="1440" SmallChange="1" LargeChange="10"
                                         SpinButtonPlacementMode="Compact"
                                         Value="{Binding UpcomingClassRealtimeNotificationLeadMinutes, Mode=TwoWay, Converter={x:Static ci:NotNaNConverter.Instance}}" />
                    </ci:Field>
                    <ci:Field Label="显示的内容">
                        <WrapPanel>
                            <CheckBox Content="课程名" IsChecked="{Binding UpcomingClassRealtimeNotificationShowSubjectName, Mode=TwoWay}" />
                            <CheckBox Content="剩余时间" IsChecked="{Binding UpcomingClassRealtimeNotificationShowRemainingTime, Mode=TwoWay}" />
                            <CheckBox Content="持续时间" IsChecked="{Binding UpcomingClassRealtimeNotificationShowTimeRange, Mode=TwoWay}" />
                            <CheckBox Content="上课地点" IsChecked="{Binding UpcomingClassRealtimeNotificationShowLocation, Mode=TwoWay}" />
                            <CheckBox Content="上课教师" IsChecked="{Binding UpcomingClassRealtimeNotificationShowTeacherName, Mode=TwoWay}" />
                        </WrapPanel>
                    </ci:Field>
                </StackPanel>
            </TabItem>
            <TabItem Header="课程持续信息">
                <StackPanel Spacing="4">
                    <CheckBox Content="启用课程持续实时通知"
                              IsChecked="{Binding IsCurrentClassRealtimeNotificationEnabled, Mode=TwoWay}" />
                    <ci:Field Label="显示的内容">
                        <WrapPanel>
                            <CheckBox Content="课程名" IsChecked="{Binding CurrentClassRealtimeNotificationShowSubjectName, Mode=TwoWay}" />
                            <CheckBox Content="剩余时间" IsChecked="{Binding CurrentClassRealtimeNotificationShowRemainingTime, Mode=TwoWay}" />
                            <CheckBox Content="持续时间" IsChecked="{Binding CurrentClassRealtimeNotificationShowTimeRange, Mode=TwoWay}" />
                            <CheckBox Content="上课地点" IsChecked="{Binding CurrentClassRealtimeNotificationShowLocation, Mode=TwoWay}" />
                            <CheckBox Content="上课教师" IsChecked="{Binding CurrentClassRealtimeNotificationShowTeacherName, Mode=TwoWay}" />
                        </WrapPanel>
                    </ci:Field>
                </StackPanel>
            </TabItem>
        </TabControl>
    </StackPanel>
</ci:AttachedSettingsControlBase>
