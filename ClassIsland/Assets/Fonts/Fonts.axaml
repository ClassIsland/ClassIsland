<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <OnPlatform x:Key="AppFont" x:TypeArguments="FontFamily" Android="{x:Static FontFamily.Default}">
        <OnPlatform.Default>
            <FontFamily>avares://ClassIsland/Assets/Fonts/#HarmonyOS Sans SC, HarmonyOS Sans SC, Microsoft YaHei UI, Noto Sans CJK SC, Noto Sans SC, PingFang SC, Source Han Sans SC, SimHei, WenQuanYi Micro Hei, sans-serif, avares://ClassIsland.Core/Assets/Fonts/#FluentSystemIcons-Resizable</FontFamily>
        </OnPlatform.Default>
    </OnPlatform>
</ResourceDictionary>
