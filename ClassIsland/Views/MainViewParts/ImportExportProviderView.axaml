<ci:ViewBase xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:ClassIsland.ViewModels.MainViewParts"
             xmlns:ci="http://classisland.tech/schemas/xaml/core"
             xmlns:controls="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             x:Class="ClassIsland.Views.MainViewParts.ImportExportProviderView"
             ci:ViewHostAssist.DrawerMaxWidth="480"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance viewModels:ImportExportProviderViewModel}"
             ci:ViewHostAssist.DrawerContentHeightRatio="0.7"
             Header="{Binding Title}">
    <Grid RowDefinitions="*,Auto,Auto" IsEnabled="{Binding !IsBusy}">
        <ContentControl Grid.Row="0"
                        Content="{Binding ProviderContent}"/>
        <Separator Grid.Row="1" Margin="12 0"/>
        <Grid Grid.Row="2" Margin="12">
            <controls:FAProgressRing Width="32" Height="32"
                                     IsActive="{Binding IsBusy}"
                                     IsIndeterminate="True"
                                     IsVisible="{Binding IsBusy}"/>
            <Button x:Name="InvokeButton" Classes="accent"
                    Content="{Binding InvokeButtonText}"
                    Padding="32 6"
                    HorizontalAlignment="Right" Click="InvokeButton_OnClick"/>
        </Grid>
    </Grid>
</ci:ViewBase>
