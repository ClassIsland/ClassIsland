<ci:ViewBase xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ci="http://classisland.tech/schemas/xaml/core"
             x:Class="ClassIsland.Views.MainView"
             NavigationPage.HasBackButton="False"
             NavigationPage.BarHeightOverride="42"
             Header="{Binding #MainPageHost.CurrentPage.Header, TargetNullValue=ClassIsland, FallbackValue=ClassIsland}"
             HeaderTemplate="{Binding #MainPageHost.CurrentPage.HeaderTemplate}">
    <NavigationPage.TopCommandBar>
        <ContentControl Content="{Binding #MainPageHost.CurrentPage.TopCommandBar}"
                        DataContext="{Binding #MainPageHost.CurrentPage.DataContext}"
                        VerticalContentAlignment="Stretch"/>
    </NavigationPage.TopCommandBar>
    <ci:ViewBase.Resources>
        <!-- The outer navigation bar hosts TopCommandBar. Render the page body and bottom bar here. -->
        <ControlTemplate x:Key="MainViewPageTemplate" TargetType="ci:MainViewPageBase">
            <DockPanel Background="{TemplateBinding Background}">
                <ContentPresenter x:Name="PART_BottomCommandBar"
                                  DockPanel.Dock="Bottom"
                                  Content="{TemplateBinding BottomCommandBar}"/>
                <ContentPresenter x:Name="PART_ContentPresenter"
                                  Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
            </DockPanel>
        </ControlTemplate>
    </ci:ViewBase.Resources>
    <ci:ViewBase.Styles>
        <Style Selector="ci|AdaptiveNavigationView#MainNavigation:not(.full-width-title) /template/ ContentControl#HeaderContent">
            <Setter Property="MaxWidth" Value="{StaticResource SettingsContainerWidth}"/>
            <!-- Match the horizontal margins of settings-container and keep the navigation header's top spacing. -->
            <Setter Property="Margin" Value="12,44,18,0"/>
        </Style>
        <Style Selector="NavigationPage.main-view-pages /template/ ContentPresenter#PART_Header">
            <Setter Property="Content" Value="{x:Null}"/>
        </Style>
        <Style Selector="NavigationPage.main-view-pages /template/ ContentPresenter#PART_TopCommandBar">
            <Setter Property="Content" Value="{x:Null}"/>
        </Style>
    </ci:ViewBase.Styles>
    <ci:AdaptiveNavigationView x:Name="MainNavigation">
        <NavigationPage x:Name="MainPageHost" Classes="main-view-pages">
            <NavigationPage.PageTransition>
                <ci:CompositionPageTransition Duration="0:0:0.25"
                                              Orientation="Vertical"
                                              SlideDistance="100"
                                              SlideOut="False"
                                              SlideInEasing="0,0 0,1"
                                              FadeInEasing="0,0 0,1"
                                              FadeOutEasing="0,0 0,1"/>
            </NavigationPage.PageTransition>
        </NavigationPage>
    </ci:AdaptiveNavigationView>
</ci:ViewBase>
