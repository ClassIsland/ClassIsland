<ci:ViewBase xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ci="http://classisland.tech/schemas/xaml/core"
             xmlns:controls="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             xmlns:scheduleWeek="clr-namespace:ClassIsland.Controls.ScheduleWeekEdit"
             xmlns:views="clr-namespace:ClassIsland.Views"
             xmlns:attachedSettings="using:ClassIsland.Core.Models.AttachedSettings"
             xmlns:appControls="using:ClassIsland.Controls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="ClassIsland.Views.MainView"
             x:Name="MainViewRoot"
             NavigationPage.HasBackButton="False"
             NavigationPage.BarHeightOverride="42"
             Header="{Binding #MainViewRoot.ViewModel.MainViewHeader}">
    <NavigationPage.TopCommandBar>
        <StackPanel Orientation="Horizontal" Spacing="0">
            <Button x:Name="EditScheduleButton" Theme="{StaticResource TransparentButton}"
                    IsVisible="{Binding #MainViewRoot.ViewModel.CanStartScheduleEditing}"
                    ToolTip.Tip="编辑课表" Click="EditScheduleButton_OnClick">
                <ci:FluentIcon Glyph="{ci:FI EditRegular}"/>
            </Button>
            <Button x:Name="AddScheduleButton" Theme="{StaticResource TransparentButton}"
                    IsVisible="{Binding #MainViewRoot.ViewModel.CanAddScheduleItem}"
                    ToolTip.Tip="新增课程" Click="AddScheduleButton_OnClick">
                <ci:FluentIcon Glyph="{ci:FI AddRegular}"/>
            </Button>
            <Button x:Name="FinishEditingButton" Theme="{StaticResource TransparentButton}"
                    IsVisible="{Binding #MainViewRoot.ViewModel.IsScheduleEditing}"
                    ToolTip.Tip="完成编辑" Click="FinishEditingButton_OnClick">
                <ci:FluentIcon Glyph="{ci:FI CheckmarkRegular}"/>
            </Button>
            <Button x:Name="MainMoreButton" Theme="{StaticResource TransparentButton}"
                    ToolTip.Tip="更多选项" Click="MainMoreButton_OnClick">
                <ci:FluentIcon Glyph="{ci:FI MoreHorizontalRegular}"/>
            </Button>
        </StackPanel>
    </NavigationPage.TopCommandBar>
    <ci:ViewBase.Styles>
        <Style Selector="TabControl#MainViewTabs /template/ ItemsPresenter#PART_ItemsPresenter">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="TextBlock#HomeScheduleSummary.adjusted">
            <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
        </Style>
        <Style Selector="ci|LessonsListBox#HomeLessonsList">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ci|LessonsListBox#HomeLessonsList ListBoxItem">
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
    </ci:ViewBase.Styles>
    <ci:AdaptiveNavigationView x:Name="MainNavigation"
                               Header="{Binding #MainViewTabs.SelectedItem.Header}">
        <ci:AdaptiveNavigationView.MenuItems>
            <controls:FANavigationViewItem x:Name="HomeNavigationItem"
                                           Content="今天"
                                           IconSource="{ci:FluentIconSource {ci:FI HomeRegular}, FontSize=22}" />
            <controls:FANavigationViewItem x:Name="WeekNavigationItem"
                                           Content="本周"
                                           IconSource="{ci:FluentIconSource {ci:FI CalendarWeekStartRegular}, FontSize=22}" />
            <controls:FANavigationViewItem x:Name="MoreNavigationItem"
                                           Content="更多"
                                           IconSource="{ci:FluentIconSource {ci:FI MoreHorizontalRegular}, FontSize=22}" />
        </ci:AdaptiveNavigationView.MenuItems>
        <ci:ReusableTabControl x:Name="MainViewTabs" SelectedIndex="0"
                               HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                               Padding="0" Margin="0">
            <TabItem Header="今天">
                <Border>
                    <Border.Styles>
                        <Style Selector="appControls|HomeDatePicker#HomeCalendar">
                            <Setter Property="MaxHeight" Value="{Binding #HomeContent.Bounds.Height, Converter={x:Static appControls:HomeDatePicker.AvailableHeightConverter}}"/>
                            <Setter Property="Grid.ColumnSpan" Value="2"/>
                        </Style>
                        <Style Selector="ScrollViewer#HomeLessons">
                            <Setter Property="Grid.Row" Value="1"/>
                            <Setter Property="Grid.ColumnSpan" Value="2"/>
                        </Style>
                        <Style Selector="Grid#HomeContent.wide">
                            <Setter Property="ColumnSpacing" Value="12"/>
                            <Setter Property="Margin" Value="56,16,16,16"/>
                        </Style>
                        <Style Selector="Grid#HomeContent.wide > appControls|HomeDatePicker#HomeCalendar">
                            <Setter Property="IsExpandedPermanently" Value="True"/>
                            <Setter Property="Width" Value="300"/>
                            <Setter Property="Grid.ColumnSpan" Value="1"/>
                            <Setter Property="Grid.RowSpan" Value="2"/>
                            <Setter Property="MaxHeight" Value="Infinity"/>
                            <Setter Property="VerticalAlignment" Value="Top"/>
                        </Style>
                        <Style Selector="Grid#HomeContent.wide > ScrollViewer#HomeLessons">
                            <Setter Property="Grid.Row" Value="0"/>
                            <Setter Property="Grid.Column" Value="1"/>
                            <Setter Property="Grid.ColumnSpan" Value="1"/>
                            <Setter Property="Grid.RowSpan" Value="2"/>
                        </Style>
                    </Border.Styles>
                    <Grid x:Name="HomeContent" RowDefinitions="Auto,*" ColumnDefinitions="Auto,*"
                          Classes.wide="{Binding !#MainNavigation.IsNarrow}">
                        <appControls:HomeDatePicker x:Name="HomeCalendar" DataContext="{Binding $parent[views:MainView].ViewModel}"/>
                        <ScrollViewer x:Name="HomeLessons" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <Grid RowDefinitions="Auto,*">
                                <Grid ColumnDefinitions="*,Auto" Margin="0 4">
                                    <TextBlock x:Name="HomeScheduleSummary" Classes="l-instructive"
                                               Classes.adjusted="{Binding $parent[views:MainView].ViewModel.HasDisplayedScheduleAdjustment}"
                                               Text="{Binding $parent[views:MainView].ViewModel.DisplayedScheduleSummary}"
                                               VerticalAlignment="Center" Margin="16,0,8,0" TextWrapping="Wrap"/>
                                    <Button Grid.Column="1" HorizontalAlignment="Right" Theme="{StaticResource TransparentButton}"
                                            ToolTip.Tip="调整所选日期课程" AutomationProperties.Name="调整所选日期课程"
                                            IsVisible="{Binding $parent[views:MainView].ViewModel.IsScheduleAdjustmentVisible}"
                                            IsEnabled="{Binding $parent[views:MainView].ViewModel.CanAdjustSchedule}"
                                            Click="ButtonAdjustSchedule_OnClick">
                                        <ci:FluentIcon Glyph="{ci:FI MoreHorizontalRegular}"/>
                                    </Button>
                                </Grid>
                                <Panel Grid.Row="1">
                                    <ci:LessonsListBox x:Name="HomeLessonsList"
                                                       ClassPlan="{Binding $parent[views:MainView].ViewModel.DisplayedClassPlan}"
                                                       Subjects="{Binding $parent[views:MainView].ViewModel.ProfileService.Profile.Subjects}"
                                                       SelectedIndex="{Binding $parent[views:MainView].ViewModel.DisplayedSelectedIndex, Mode=OneWay}"
                                                       IsHitTestVisible="True"
                                                       IsLiveUpdatingEnabled="{Binding $parent[views:MainView].ViewModel.IsViewingToday}"
                                                       FadeCompletedClasses="{Binding $parent[views:MainView].ViewModel.IsViewingToday}"
                                                       IsVisible="{Binding $parent[views:MainView].ViewModel.HasDisplayedLessons}"
                                                       Orientation="Vertical">
                                        <ci:LessonsListBox.LessonControlSettings>
                                            <attachedSettings:LessonControlAttachedSettings ExtraInfoType="4"/>
                                        </ci:LessonsListBox.LessonControlSettings>
                                    </ci:LessonsListBox>
                                    <Border Background="Transparent"
                                            Tapped="HomeLessonsList_OnTapped"/>
                                    <TextBlock Text="这一天没有课程安排" Margin="16,32" HorizontalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               IsVisible="{Binding !$parent[views:MainView].ViewModel.HasDisplayedLessons}"/>
                                </Panel>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </TabItem>
            <TabItem Header="本周">
                <Grid RowDefinitions="Auto,*">
                    <WrapPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Button Click="ScheduleWeekPrevious_OnClick" ToolTip.Tip="上一周" Margin="0,0,4,0"
                                AutomationProperties.Name="上一周" Theme="{StaticResource TransparentButton}">
                            <ci:FluentIcon Glyph="{ci:FI ChevronLeftRegular}"/>
                        </Button>
                        <Button Click="ScheduleWeekToday_OnClick" Content="本周" Margin="0,0,4,0"
                                ToolTip.Tip="返回本周" Theme="{StaticResource TransparentButton}"/>
                        <Button Click="ScheduleWeekNext_OnClick" ToolTip.Tip="下一周" Margin="0,0,4,0"
                                AutomationProperties.Name="下一周" Theme="{StaticResource TransparentButton}">
                            <ci:FluentIcon Glyph="{ci:FI ChevronRightRegular}"/>
                        </Button>
                        <TextBlock Text="{Binding #MainViewRoot.ViewModel.ScheduleWeekCaption}"
                                   VerticalAlignment="Center" FontSize="12"/>
                    </WrapPanel>
                    <scheduleWeek:ScheduleWeekEditControl x:Name="ScheduleWeekTest" Grid.Row="1"
                                                         WeekStart="{Binding #MainViewRoot.ViewModel.ScheduleWeekStart}"
                                                         SelectedDate="{Binding #MainViewRoot.ViewModel.ScheduleWeekSelectedDate, Mode=TwoWay}"
                                                         SelectedTime="{Binding #MainViewRoot.ViewModel.ScheduleWeekSelectedTime, Mode=TwoWay}"
                                                         IsReadonly="{Binding #MainViewRoot.ViewModel.IsScheduleWeekReadonly}"
                                                         CourseTapped="ScheduleWeekEditor_OnCourseTapped"
                                                         CreateRequested="ScheduleWeekEditor_OnCreateRequested"
                                                         EditRequested="ScheduleWeekEditor_OnEditRequested"
                                                         DeleteRequested="ScheduleWeekEditor_OnDeleteRequested"
                                                         DuplicateRequested="ScheduleWeekEditor_OnDuplicateRequested"
                                                         ForkAndReplaceRequested="ScheduleWeekEditor_OnForkAndReplaceRequested"
                                                         DayHeaderClicked="ScheduleWeekEditor_OnDayHeaderClicked"/>
                    <TextBlock Grid.Row="1"
                               Text="点击课程开始编辑，长按后拖动课程"
                               HorizontalAlignment="Right" VerticalAlignment="Bottom"
                               Margin="0,0,16,16" Padding="8,4"
                               Classes="l-instructive"
                               IsVisible="{Binding $parent[views:MainView].ViewModel.IsScheduleEditing}"/>
                </Grid>
            </TabItem>
            <TabItem Header="更多">
                <ScrollViewer>
                    <StackPanel Classes="settings-container animated-intro">
                        <controls:FASettingsExpander IconSource="{ci:FluentIconSource &#xE699;}"
                                                 Header="编辑档案…"
                                                 IsClickEnabled="True"
                                                 Click="ButtonSettings_OnClick"/>
                        <controls:FASettingsExpander IconSource="{ci:FluentIconSource &#xE6A1;}"
                                                 Header="加载临时课表…"
                                                 IsClickEnabled="True"
                                                 Click="MenuItemTemporaryClassPlan_OnClick"/>
                        <controls:FASettingsExpander IconSource="{ci:FluentIconSource &#xE15F;}"
                                                 Header="换课…"
                                                 IsClickEnabled="True"
                                                 Click="MenuItemClassSwap_OnClick"/>
                        <Separator/>
                        <controls:FASettingsExpander IconSource="{ci:FluentIconSource &#xE7C9;}"
                                                 Header="编辑主界面…"
                                                 IsClickEnabled="True"/>
                        <controls:FASettingsExpander IconSource="{ci:FluentIconSource &#xEF27;}"
                                                 Header="应用设置…"
                                                 IsClickEnabled="True"
                                                 Click="MenuItemSettings_OnClick"/>
                        <Separator/>
                        <controls:FASettingsExpander IconSource="{ci:FluentIconSource &#xE0BD;}"
                                                 Header="重启"
                                                 IsClickEnabled="True"
                                                 Click="MenuItemRestartApp_OnClick"/>
                        <controls:FASettingsExpander IconSource="{ci:FluentIconSource &#xE0DF;}"
                                                 Header="退出"
                                                 IsClickEnabled="True"
                                                 Click="MenuItemExitApp_OnClick"/>
                        <Separator/>
                        <controls:FASettingsExpander IconSource="{ci:FluentIconSource {ci:FI BugRegular}}"
                                                 Header="Dev Portal"
                                                 IsClickEnabled="True"
                                                 Click="FASettingsExpanderDevPortal_OnClick"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </ci:ReusableTabControl>
    </ci:AdaptiveNavigationView>
</ci:ViewBase>
