<ci:ViewBase xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ci="http://classisland.tech/schemas/xaml/core"
             xmlns:controls="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             x:Class="ClassIsland.Views.SettingPages.AccentPreviewView"
             x:Name="PreviewView"
             Header="主题色提取预览"
             ci:ViewHostAssist.DrawerMaxWidth="480">
    <NavigationPage.TopCommandBar>
        <Button Theme="{StaticResource TransparentButton}"
                ToolTip.Tip="刷新"
                AutomationProperties.Name="刷新主题色预览"
                IsEnabled="{Binding !#PreviewView.ViewModel.AccentPicker.IsWorking}"
                Click="Refresh_OnClick">
            <ci:FluentIcon Glyph="{ci:FI ArrowSyncRegular}"/>
        </Button>
    </NavigationPage.TopCommandBar>

    <Grid ClipToBounds="True">
        <Image x:Name="PreviewImage" Stretch="Uniform"/>
        <ProgressBar VerticalAlignment="Top"
                     IsIndeterminate="True"
                     IsVisible="{Binding #PreviewView.ViewModel.AccentPicker.IsWorking}"/>
        <controls:FAInfoBar VerticalAlignment="Bottom"
                            IsOpen="{Binding !!#PreviewView.RefreshError}"
                            Message="{Binding #PreviewView.RefreshError}"
                            Severity="Warning" IsClosable="False"/>
    </Grid>
</ci:ViewBase>
