<ci:SettingsPageBase xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ci="http://classisland.tech/schemas/xaml/core"
                    xmlns:controls="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
                    xmlns:appControls="using:ClassIsland.Controls"
                    xmlns:local="clr-namespace:ClassIsland.Views.SettingPages"
                    x:Class="ClassIsland.Views.SettingPages.LiveActivitySettingsPage"
                    Loaded="OnLoaded"
                    Unloaded="OnUnloaded">
    <ScrollViewer>
        <StackPanel Classes="settings-container animated-intro" Spacing="8">
            <TextBlock Text="在灵动岛和锁屏实时活动中查看即将开始或正在进行的课程。分别设置提醒时间和显示内容。"
                       Classes="l-instructive" TextWrapping="Wrap" />
            <appControls:RealtimeNotificationSettingsControl DataContext="{Binding ViewModel.SettingsService.Settings}" />

            <controls:FAInfoBar IsOpen="True"
                                IsClosable="False"
                                Severity="Informational"
                                Message="开启自定义后，可调整灵动岛展开态的组件和顺序。课程组件也会遵循上方的内容选项。" />

            <Grid ColumnDefinitions="*,Auto" Margin="0 8 0 4">
                <StackPanel>
                    <TextBlock Text="自定义展开态组件" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="配置显示顺序和组件内容，最多显示 6 个组件。"
                               Classes="l-instructive" TextWrapping="Wrap" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1"
                              IsChecked="{Binding ViewModel.SettingsService.Settings.IsLiveActivityLayoutCustomized, Mode=TwoWay}"
                              VerticalAlignment="Top" />
            </Grid>

            <TextBlock Text="上课期间预览" FontSize="16" FontWeight="SemiBold" Margin="0 12 0 4" />
            <appControls:LiveActivityPreviewControl DataContext="{Binding ViewModel}" />

            <Grid ColumnDefinitions="*,Auto" Margin="0 16 0 4">
                <StackPanel>
                    <TextBlock Text="组件顺序" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="拖动左侧手柄或使用箭头调整顺序。选择一项后在下方编辑它的设置。"
                               Classes="l-instructive" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" Content="恢复默认" Click="RestoreDefaults_OnClick"
                        Theme="{StaticResource TransparentButton}" VerticalAlignment="Top" />
            </Grid>

            <ListBox ItemsSource="{Binding ViewModel.Components}"
                     SelectedItem="{Binding ViewModel.SelectedComponent, Mode=TwoWay}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerTheme>
                    <ControlTheme TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="Height" Value="48" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Interaction.Behaviors">
                            <BehaviorCollectionTemplate>
                                <BehaviorCollection>
                                    <ci:AdvancedItemDragBehavior Orientation="Vertical"
                                                                AllowDragFromDragThumbOnly="True" />
                                </BehaviorCollection>
                            </BehaviorCollectionTemplate>
                        </Setter>
                    </ControlTheme>
                </ListBox.ItemContainerTheme>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8" Height="40">
                            <ci:TouchDragThumb Grid.Column="0" Width="20" IsCompact="True"
                                               IsExplicitVisible="True" Classes="in-listbox" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Description}" Classes="l-instructive"
                                           FontSize="11" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="2" IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                          VerticalAlignment="Center" />
                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Tag="{Binding}" Click="MoveUp_OnClick"
                                        Content="{ci:FluentIcon {ci:FI ArrowUpRegular}}"
                                        AutomationProperties.Name="上移组件"
                                        Theme="{StaticResource TransparentButton}" />
                                <Button Tag="{Binding}" Click="MoveDown_OnClick"
                                        Content="{ci:FluentIcon {ci:FI ArrowDownRegular}}"
                                        AutomationProperties.Name="下移组件"
                                        Theme="{StaticResource TransparentButton}" />
                                <Button Tag="{Binding}" Click="Remove_OnClick"
                                        Content="{ci:FluentIcon {ci:FI DeleteRegular}}"
                                        AutomationProperties.Name="移除组件"
                                        Theme="{StaticResource TransparentButton}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border IsVisible="{Binding ViewModel.IsComponentSelected}"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="4" Padding="12" Margin="0 8 0 0">
                <StackPanel DataContext="{Binding ViewModel.SelectedComponent}" Spacing="8">
                    <TextBlock Text="{Binding DisplayName}" FontSize="16" FontWeight="SemiBold" />
                    <TextBox Text="{Binding Text, Mode=TwoWay}"
                             IsVisible="{Binding IsTextComponent}"
                             PlaceholderText="输入展开态要显示的短文本"
                             MaxLength="500"
                             AutomationProperties.Name="文本组件内容" />
                    <StackPanel IsVisible="{Binding IsScheduleComponent}" Spacing="4">
                        <CheckBox Content="显示下一节课程" IsChecked="{Binding ShowNextLesson, Mode=TwoWay}" />
                        <CheckBox Content="显示课程进度" IsChecked="{Binding ShowProgress, Mode=TwoWay}" />
                    </StackPanel>
                    <StackPanel IsVisible="{Binding IsCountdownComponent}" Spacing="6">
                        <CheckBox Content="倒计时到自定义日期" IsChecked="{Binding UseCustomCountdown, Mode=TwoWay}" />
                        <TextBlock Text="未启用时显示当前课程或课间的剩余时间。" Classes="l-instructive"
                                   IsVisible="{Binding !UseCustomCountdown}" TextWrapping="Wrap" />
                        <StackPanel IsVisible="{Binding UseCustomCountdown}" Spacing="6">
                            <TextBox Text="{Binding CountdownName, Mode=TwoWay}" PlaceholderText="倒计时名称"
                                     MaxLength="80" AutomationProperties.Name="倒计时名称" />
                            <CalendarDatePicker SelectedDate="{Binding TargetDate, Mode=TwoWay}"
                                                AutomationProperties.Name="倒计时目标日期" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <controls:FASettingsExpander Header="添加组件"
                                         IconSource="{ci:FluentIconSource {ci:FI AddRegular}}"
                                         IsExpanded="True" Margin="0 12 0 0">
                <ItemsControl ItemsSource="{Binding ViewModel.AvailableKinds}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Tag="{Binding Kind}" Click="AddComponent_OnClick"
                                    Content="{Binding DisplayName}"
                                    IsEnabled="{Binding $parent[local:LiveActivitySettingsPage].ViewModel.CanAddComponent}"
                                    Margin="0 0 8 8" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </controls:FASettingsExpander>
        </StackPanel>
    </ScrollViewer>
</ci:SettingsPageBase>
