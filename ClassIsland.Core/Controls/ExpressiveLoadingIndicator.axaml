<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="http://classisland.tech/schemas/xaml/core">
    <Design.PreviewWith>
        <Border Padding="20">
            <controls:ExpressiveLoadingIndicator />
        </Border>
    </Design.PreviewWith>

    <Style Selector="controls|ExpressiveLoadingIndicator">
        <Setter Property="Width" Value="168" />
        <Setter Property="Height" Value="56" />
        <Setter Property="Foreground" Value="{DynamicResource AccentFillColorDefaultBrush}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel />
            </ControlTemplate>
        </Setter>
    </Style>
</Styles>
