<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:ClassIsland.Core.Controls"
        xmlns:icons="using:ClassIsland.Core.Icons">
    <Design.PreviewWith>
        <controls:VerticalDrawer />
    </Design.PreviewWith>

    <Style Selector="controls|VerticalDrawer">
        <Setter Property="CornerRadius" Value="8 8 0 0"/>
        <Setter Property="Background" Value="{DynamicResource ContentDialogBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ContentDialogBorderBrush}"/>
        <Setter Property="BorderThickness" Value="{DynamicResource ContentDialogBorderWidth}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    <Border x:Name="PART_DismissLayer" 
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"/>
                    <Canvas x:Name="PART_Canvas" ClipToBounds="True"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch">
                        <Panel x:Name="WorkingPanel" 
                               Height="{TemplateBinding ContainerHeight}"
                               Width="{Binding #PART_Canvas.Bounds.Width}">
                            <Border x:Name="PART_BackgroundElement"
                                    Background="{TemplateBinding Background}"
                                    BorderThickness="{StaticResource ContentDialogBorderWidth}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    MaxWidth="{Binding #PART_Canvas.Bounds.Width}"
                                    Width="{TemplateBinding RequestedWidth}"
                                    HorizontalAlignment="Center"
                                    BoxShadow="0 8 32 0 #66000000"
                                    BackgroundSizing="{TemplateBinding BackgroundSizing}">
                                <!-- Even in WinUI, shadow is always black regardless of light/dark mode -->

                                <!-- if this border isn't here, dialog space displays outside of corner radius at top
                                 if we put ClipToBounds=True on BackgroundElement above, it clips the shadow -->
                                <Border ClipToBounds="True"
                                        CornerRadius="{TemplateBinding CornerRadius}"
                                        Padding="8 8 8 0">
                                    <Grid RowDefinitions="32, *">
                                        <!-- Title -->
                                        <Grid x:Name="PART_TitleBar" Background="Transparent"
                                              ColumnDefinitions="*, Auto">
                                            <ContentPresenter x:Name="PART_TitleContentPresenter"
                                                              Grid.Row="0" Grid.Column="0"
                                                              VerticalAlignment="Center"
                                                              Content="{TemplateBinding Title}"
                                                              ContentTemplate="{TemplateBinding TitleTemplate}" />
                                            <StackPanel Grid.Row="0" Grid.Column="1"
                                                        Orientation="Horizontal" Classes="items-valign-center"
                                                        Spacing="4">
                                                <Button Theme="{StaticResource TransparentButton}"
                                                        Content="{controls:FluentIcon {x:Static icons:FluentIcons.ChevronDownRegular}}"
                                                        ToolTip.Tip="收起"
                                                        Command="{Binding Collapse, RelativeSource={RelativeSource TemplatedParent}}">
                                                    <Button.IsVisible>
                                                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                            <TemplateBinding Property="AllowCollapse" />
                                                            <TemplateBinding Property="State"
                                                                             Converter="{x:Static ObjectConverters.Equal}">
                                                                <TemplateBinding.ConverterParameter>
                                                                    <controls:VerticalDrawerOpenState>Opened</controls:VerticalDrawerOpenState>
                                                                </TemplateBinding.ConverterParameter>
                                                            </TemplateBinding>
                                                        </MultiBinding>
                                                    </Button.IsVisible>
                                                </Button>
                                                <Button Theme="{StaticResource TransparentButton}"
                                                        Content="{controls:FluentIcon {x:Static icons:FluentIcons.ChevronUpRegular}}"
                                                        ToolTip.Tip="展开"
                                                        Command="{Binding Open, RelativeSource={RelativeSource TemplatedParent}}">
                                                    <Button.IsVisible>
                                                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                            <TemplateBinding Property="AllowCollapse" />
                                                            <TemplateBinding Property="State"
                                                                             Converter="{x:Static ObjectConverters.NotEqual}">
                                                                <TemplateBinding.ConverterParameter>
                                                                    <controls:VerticalDrawerOpenState>Opened</controls:VerticalDrawerOpenState>
                                                                </TemplateBinding.ConverterParameter>
                                                            </TemplateBinding>
                                                        </MultiBinding>
                                                    </Button.IsVisible>
                                                </Button>
                                                <Button Theme="{StaticResource TransparentButton}"
                                                        Content="{controls:FluentIcon {x:Static icons:FluentIcons.DismissRegular}}"
                                                        ToolTip.Tip="关闭"
                                                        Command="{Binding Close, RelativeSource={RelativeSource TemplatedParent}}" />
                                            </StackPanel>
                                        </Grid>
                                        <!-- Content -->
                                        <ContentPresenter x:Name="PART_ContentPresenter"
                                                          Grid.Row="1"
                                                          Content="{TemplateBinding DrawerContent}"
                                                          ContentTemplate="{TemplateBinding DrawerTemplate}"
                                                          HorizontalContentAlignment="{TemplateBinding DrawerHorizontalContentAlignment}"
                                                          VerticalContentAlignment="{TemplateBinding DrawerVerticalContentAlignment}">
                                        </ContentPresenter>
                                    </Grid>
                                </Border>
                            </Border>
                        </Panel>
                    </Canvas>
                </Panel>
            </ControlTemplate>
        </Setter>
        
        <Style Selector="^ /template/ Panel#WorkingPanel">
            <Setter Property="Opacity" Value="0"/>
        </Style>
        <Style Selector="^:layout-ready /template/ Panel#WorkingPanel">
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="^:animated:layout-ready:not(:dragging) /template/ Panel#WorkingPanel">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Canvas.Bottom" Duration="0:0:0.25" Easing="0,0 0,1" />
                    <DoubleTransition Property="Height" Duration="0:0:0.25" Easing="0,0 0,1" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="^ /template/ Border#PART_DismissLayer">
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Opacity" Value="0"/>
        </Style>
        <Style Selector="^[SmokeBackground=True] /template/ Border#PART_DismissLayer">
            <Setter Property="Background" Value="{DynamicResource SmokeFillColorDefaultBrush}"/>
        </Style>
        <Style Selector="^:animated:layout-ready[SmokeBackground=True] /template/ Border#PART_DismissLayer">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.25"
                                      Easing="0,0 0,1" />
                </Transitions>
            </Setter>
        </Style>
        
        <Style Selector="^:opened">
            <Style Selector="^ /template/ Border#PART_DismissLayer">
                <Setter Property="IsHitTestVisible" Value="True"/>
                <Setter Property="Opacity" Value="1"/>
            </Style>
            
        </Style>
    </Style>
</Styles>
