<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ci="http://classisland.tech/schemas/xaml/core"
        xmlns:ui="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
        xmlns:uip="clr-namespace:FluentAvalonia.UI.Controls.Primitives;assembly=FluentAvalonia">
    <Styles.Resources>
        <ControlTheme x:Key="AdaptiveNavigationViewItemPresenterTheme"
                      TargetType="uip:FANavigationViewItemPresenter">
            <Setter Property="Template">
                <ControlTemplate>
                    <Panel Name="PresenterContentRootGrid" Width="74" Height="66">
                        <Border Name="LayoutRoot" Margin="5 3" CornerRadius="3"
                                Background="Transparent">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="2">
                                <ContentPresenter Name="Icon"
                                                  Width="23" Height="23"
                                                  HorizontalAlignment="Center"
                                                  Content="{Binding TemplateSettings.Icon, RelativeSource={RelativeSource TemplatedParent}}"
                                                  Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <ContentPresenter Name="ContentPresenter"
                                                  HorizontalAlignment="Center"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  FontSize="10"
                                                  Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </StackPanel>
                        </Border>
                        <!-- FANavigationView needs this named part, but its compositor animation cannot follow the reflowed menu. -->
                        <Panel Opacity="0" IsHitTestVisible="False">
                            <Border Name="SelectionIndicator"
                                    Width="16" Height="3"
                                    HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                    Margin="0 0 0 1"
                                    CornerRadius="2"
                                    Background="{DynamicResource NavigationViewSelectionIndicatorForeground}"
                                    Opacity="0" />
                        </Panel>
                    </Panel>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover /template/ Border#LayoutRoot">
                <Setter Property="Background" Value="{DynamicResource NavigationViewItemBackgroundPointerOver}" />
            </Style>
            <Style Selector="^:pressed /template/ Border#LayoutRoot">
                <Setter Property="Background" Value="{DynamicResource NavigationViewItemBackgroundPressed}" />
            </Style>
            <Style Selector="^:selected /template/ Border#LayoutRoot">
                <Setter Property="Background" Value="{DynamicResource NavigationViewItemBackgroundSelected}" />
            </Style>
            <Style Selector="^:selected /template/ ContentPresenter#Icon">
                <Setter Property="Foreground" Value="{DynamicResource AccentFillColorDefaultBrush}" />
            </Style>
            <Style Selector="^:selected /template/ ContentPresenter#ContentPresenter">
                <Setter Property="IsVisible" Value="False" />
            </Style>
        </ControlTheme>

        <ControlTheme x:Key="{x:Type ci:AdaptiveNavigationView}"
                      TargetType="ci:AdaptiveNavigationView">
            <Setter Property="PaneDisplayMode" Value="LeftCompact" />
            <Setter Property="CompactPaneLength" Value="0" />
            <Setter Property="IsPaneOpen" Value="False" />
            <Setter Property="IsPaneToggleButtonVisible" Value="False" />
            <Setter Property="IsSettingsVisible" Value="False" />
            <Setter Property="AlwaysShowHeader" Value="True" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Container.Name="AdaptiveNavigation" Container.Sizing="Width"
                            Background="{TemplateBinding Background}">
                        <DockPanel LastChildFill="True">
                            <!-- FANavigationView looks up these template parts even when their features are hidden. -->
                            <Panel IsVisible="False">
                                <Button Name="TogglePaneButton" />
                                <Button Name="NavigationViewBackButton" />
                                <Button Name="NavigationViewCloseButton" />
                                <Button Name="PaneAutoSuggestButton" />
                                <TextBlock Name="PaneTitleTextBlock" />
                                <Panel Name="PaneTitleHolder">
                                    <ContentControl Name="PaneTitlePresenter" />
                                </Panel>
                                <Grid Name="TopNavGrid" ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto,Auto,Auto">
                                    <Rectangle Name="BackButtonPlaceholderOnTopNav" />
                                    <ContentControl Name="PaneHeaderOnTopPane" />
                                    <ContentControl Name="PaneTitleOnTopPane" />
                                    <ui:FAItemsRepeater Name="TopNavMenuItemsHost">
                                        <ui:FAItemsRepeater.Layout>
                                            <ui:FAStackLayout Orientation="Horizontal" />
                                        </ui:FAItemsRepeater.Layout>
                                    </ui:FAItemsRepeater>
                                    <ui:FAItemsRepeater Name="TopNavMenuItemsOverflowHost">
                                        <ui:FAItemsRepeater.Layout>
                                            <ui:FAStackLayout Orientation="Vertical" />
                                        </ui:FAItemsRepeater.Layout>
                                    </ui:FAItemsRepeater>
                                    <Button Name="TopNavOverflowButton" />
                                    <ContentControl Name="PaneCustomContentOnTopPane" />
                                    <ContentControl Name="TopPaneAutoSuggestBoxPresenter" />
                                    <ContentControl Name="PaneFooterOnTopPane" />
                                    <ui:FAItemsRepeater Name="TopFooterMenuItemsHost">
                                        <ui:FAItemsRepeater.Layout>
                                            <ui:FAStackLayout Orientation="Horizontal" />
                                        </ui:FAItemsRepeater.Layout>
                                    </ui:FAItemsRepeater>
                                </Grid>
                                <Border Name="TopNavContentOverlayAreaGrid" />
                                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*">
                                    <Grid Name="PlaceholderGrid" Grid.Row="2"
                                          ColumnDefinitions="Auto,Auto,*" RowDefinitions="Auto">
                                        <ContentControl Name="PaneHeaderContentBorder" Grid.Column="2" />
                                    </Grid>
                                    <ContentControl Name="PaneAutoSuggestBoxPresenter" Grid.Row="3" />
                                    <ContentControl Name="PaneCustomContentBorder" Grid.Row="4" />
                                    <Grid Name="ItemsContainerGrid" Grid.Row="6" RowDefinitions="*,Auto,Auto,Auto">
                                        <ContentControl Name="FooterContentBorder" Grid.Row="2" />
                                        <ScrollViewer Name="FooterItemsScrollViewer" Grid.Row="3">
                                            <ui:FAItemsRepeater Name="FooterMenuItemsHost">
                                                <ui:FAItemsRepeater.Layout>
                                                    <ui:FAStackLayout Orientation="Vertical" />
                                                </ui:FAItemsRepeater.Layout>
                                            </ui:FAItemsRepeater>
                                        </ScrollViewer>
                                    </Grid>
                                </Grid>
                                <Rectangle Name="ContentLeftPadding" />
                            </Panel>
                            <Border Name="NavigationRail" DockPanel.Dock="Bottom" Height="71">
                                <Panel>
                                    <!-- Keep the native animation's coordinate reference in the visual tree. -->
                                    <Grid Name="PaneContentGrid" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*">
                                        <Rectangle Name="NavigationTopPadding" IsVisible="False"
                                                   Height="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TemplateSettings.TopPadding}" />
                                        <ScrollViewer Name="MenuItemsScrollViewer" Grid.Row="6"
                                                      HorizontalScrollBarVisibility="Auto"
                                                      VerticalScrollBarVisibility="Disabled">
                                            <ui:FAItemsRepeater Name="MenuItemsHost" HorizontalAlignment="Center" Tag="Horizontal">
                                                <ui:FAItemsRepeater.Layout>
                                                    <!-- Keep the layout instance while navigation items move across the breakpoint. -->
                                                    <ui:FAStackLayout Orientation="{Binding #MenuItemsHost.Tag}" />
                                                </ui:FAItemsRepeater.Layout>
                                            </ui:FAItemsRepeater>
                                        </ScrollViewer>
                                    </Grid>
                                    <Canvas Name="IndicatorOverlay" ZIndex="1" IsHitTestVisible="False">
                                        <Border Name="ActiveSelectionIndicator"
                                                Width="16" Height="3"
                                                IsVisible="False"
                                                CornerRadius="2"
                                                Background="{DynamicResource NavigationViewSelectionIndicatorForeground}">
                                            <Border.Transitions>
                                                <Transitions>
                                                    <DoubleTransition Property="Canvas.Left" Duration="0:0:0.25" Easing="CubicEaseOut" />
                                                    <DoubleTransition Property="Canvas.Top" Duration="0:0:0.25" Easing="CubicEaseOut" />
                                                </Transitions>
                                            </Border.Transitions>
                                        </Border>
                                    </Canvas>
                                </Panel>
                            </Border>
                            <SplitView Name="RootSplitView"
                                       CompactPaneLength="0" IsPaneOpen="False"
                                       Background="Transparent">
                                <SplitView.Content>
                                    <Grid RowDefinitions="Auto,*">
                                        <Rectangle Height="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TemplateSettings.TopPadding}" />
                                        <Border Name="ContentGridBorder" Grid.Row="1"
                                                ClipToBounds="True"
                                                Background="{DynamicResource NavigationViewContentBackground}"
                                                BorderBrush="{DynamicResource NavigationViewContentGridBorderBrush}"
                                                BorderThickness="1">
                                            <Grid RowDefinitions="Auto,*">
                                                <ContentControl Name="HeaderContent"
                                                                Content="{TemplateBinding Header}"
                                                                ContentTemplate="{TemplateBinding HeaderTemplate}"
                                                                Theme="{StaticResource NavigationViewTitleHeaderContentControlTextStyle}"
                                                                FontWeight="Normal"
                                                                Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                <ContentPresenter Name="ContentPresenter" Grid.Row="1"
                                                                  Content="{TemplateBinding Content}"
                                                                  ContentTemplate="{TemplateBinding ContentTemplate}" />
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </SplitView.Content>
                            </SplitView>
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter>

            <ContainerQuery Name="AdaptiveNavigation" Query="max-width:600">
                <Style Selector="ContentControl#HeaderContent">
                    <Setter Property="IsVisible" Value="False" />
                </Style>
            </ContainerQuery>
            <ContainerQuery Name="AdaptiveNavigation" Query="min-width:600">
                <Style Selector="ContentControl#HeaderContent">
                    <Setter Property="IsVisible" Value="True" />
                </Style>
                <Style Selector="Border#ContentGridBorder">
                    <Setter Property="CornerRadius" Value="7,0,7,0" />
                </Style>
                <Style Selector="Border#NavigationRail">
                    <Setter Property="DockPanel.Dock" Value="Left" />
                    <Setter Property="Width" Value="76" />
                    <Setter Property="Height" Value="NaN" />
                </Style>
                <Style Selector="Rectangle#NavigationTopPadding">
                    <Setter Property="IsVisible" Value="True" />
                </Style>
                <Style Selector="ScrollViewer#MenuItemsScrollViewer">
                    <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
                    <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
                </Style>
                <Style Selector="ui|FAItemsRepeater#MenuItemsHost">
                    <Setter Property="HorizontalAlignment" Value="Left" />
                    <Setter Property="Tag" Value="Vertical" />
                </Style>
            </ContainerQuery>
            <Style Selector="^:headercollapsed /template/ ContentControl#HeaderContent">
                <Setter Property="IsVisible" Value="False" />
            </Style>
        </ControlTheme>
    </Styles.Resources>

    <Style Selector="ci|AdaptiveNavigationView ui|FANavigationViewItem">
        <Setter Property="Width" Value="74" />
        <Setter Property="Height" Value="66" />
        <Setter Property="Margin" Value="0" />
    </Style>
    <Style Selector="ci|AdaptiveNavigationView ui|FANavigationViewItem /template/ uip|FANavigationViewItemPresenter#NVIPresenter">
        <Setter Property="Theme" Value="{StaticResource AdaptiveNavigationViewItemPresenterTheme}" />
    </Style>
    <ContainerQuery Name="AdaptiveNavigation" Query="min-width:600">
        <Style Selector="Border#ActiveSelectionIndicator">
            <Setter Property="Width" Value="3" />
            <Setter Property="Height" Value="16" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="4 0 0 0" />
        </Style>
    </ContainerQuery>
</Styles>
