{
    "app-id": "org.classisland.ClassIsland",
    "runtime": "org.freedesktop.Platform",
    "runtime-version": "24.08",
    "sdk": "org.freedesktop.Sdk",
    "sdk-extensions": [
        "org.freedesktop.Sdk.Extension.dotnet9"
    ],
    "command": "run.sh",
    "finish-args": [
        "--share=ipc",
        "--share=network",
        "--socket=x11",
        "--talk-name=org.freedesktop.Notifications",
        "--device=dri",
        "--filesystem=xdg-config:ro",
        "--filesystem=xdg-data:ro",
        "--filesystem=xdg-cache:ro"
        ],
    "build-options": {
        "append-path": "/usr/lib/sdk/dotnet9/bin",
        "append-ld-library-path": "/usr/lib/sdk/dotnet9/lib",
        "prepend-pkg-config-path": "/usr/lib/sdk/dotnet9/lib/pkgconfig",
        "env": {
            "DOTNET_CLI_TELEMETRY_OPTOUT": "1",
            "DOTNET_NO_MANIFEST_UPDATE": "1",
            "RESOLV_CONF": "/etc/resolv.conf"
        },
        "arch": {
        "aarch64": {
            "env" : {
                "RUNTIME": "linux-arm64"
            }
        },
        "x86_64": {
            "env" : {
                "RUNTIME": "linux-x64"
            }
        }
    }
    },
    "modules": [
        {
            "name": "ClassIsland",
            "buildsystem": "simple",
            "build-commands": [
                "dotnet publish -c Release --source nuget-sources --source /usr/lib/sdk/dotnet9/nuget/packages -o /app/bin ClassIsland.Desktop/ClassIsland.Desktop.csproj --runtime $RUNTIME --self-contained false -p:UseAppHost=false",
                "runtime_package=$(find nuget-sources -maxdepth 1 -name 'microsoft.netcore.app.runtime.'$RUNTIME'.*.nupkg' -print -quit); test -n \"$runtime_package\"; runtime_version=$(basename \"$runtime_package\" .nupkg | sed 's/^microsoft.netcore.app.runtime.[^.]*.//'); mkdir -p /tmp/dotnet-runtime /app/lib/dotnet/host/fxr /app/lib/dotnet/shared/Microsoft.NETCore.App/$runtime_version; install -Dm755 /usr/lib/sdk/dotnet9/lib/dotnet /app/lib/dotnet/dotnet; unzip -q \"$runtime_package\" 'runtimes/*/lib/net8.0/*' 'runtimes/*/native/*' -d /tmp/dotnet-runtime; cp -a /tmp/dotnet-runtime/runtimes/$RUNTIME/lib/net8.0/. /app/lib/dotnet/shared/Microsoft.NETCore.App/$runtime_version/; cp -a /tmp/dotnet-runtime/runtimes/$RUNTIME/native/. /app/lib/dotnet/shared/Microsoft.NETCore.App/$runtime_version/; install -Dm755 /app/lib/dotnet/shared/Microsoft.NETCore.App/$runtime_version/libhostfxr.so /app/lib/dotnet/host/fxr/$runtime_version/libhostfxr.so; rm -rf /tmp/dotnet-runtime",
                "echo flatpak>/app/bin/PackageType",
                "install -Dm755 run.sh /app/bin/run.sh",
                "install -Dm644 org.classisland.ClassIsland.desktop /app/share/applications/org.classisland.ClassIsland.desktop",
                "install -Dm644 org.classisland.ClassIsland.metainfo.xml /app/share/metainfo/org.classisland.ClassIsland.metainfo.xml",
                "install -Dm644 ClassIsland/Assets/FreedesktopIcons/AppLogo@128w.png /app/share/icons/hicolor/128x128/apps/org.classisland.ClassIsland.png"
                ],
            "sources": [
                {
                    "type": "dir",
                    "path": "../..",
                    "dest": "."
                },
                "sources.json",
                {
                    "type": "file",
                    "path": "run.sh",
                    "dest-filename": "run.sh"
                },
                {
                    "type": "file",
                    "path": "org.classisland.ClassIsland.desktop",
                    "dest-filename": "org.classisland.ClassIsland.desktop"
                },
                {
                    "type": "file",
                    "path": "org.classisland.ClassIsland.metainfo.xml",
                    "dest-filename": "org.classisland.ClassIsland.metainfo.xml"
                }
            ]
        }
    ]
}
