                  "index": 93
                },
                "region": {
                  "startLine": 165,
                  "endLine": 172,
                  "snippet": {
                    "text": "func validateSize() throws {\n        let encoder = JSONEncoder()\n        encoder.dateEncodingStrategy = .iso8601\n        let byteCount = try encoder.encode(self).count\n        guard byteCount <= 4_096 else {\n            throw ClassIslandLiveActivityInputError.payloadTooLarge(byteCount)\n        }\n    }"
                  }
                },
                "contextRegion": {
                  "startLine": 165,
                  "endLine": 172,
                  "snippet": {
                    "text": "@@ -0,1 +164,10 @@\n+\n+    func validateSize() throws {\n+        let encoder = JSONEncoder()\n+        encoder.dateEncodingStrategy = .iso8601\n+        let byteCount = try encoder.encode(self).count\n+        guard byteCount <= 4_096 else {\n+            throw ClassIslandLiveActivityInputError.payloadTooLarge(byteCount)\n+        }\n+    }\n+}"
                  }
                }
              },
