                    "text": "@_cdecl(\"ci_hud_is_running\")\npublic func ci_hud_is_running() -> Int32 {\n    hudStateLock.lock()\n    defer { hudStateLock.unlock() }\n    return hudResolveRunningPidLocked() > 0 ? 1 : 0\n}"
