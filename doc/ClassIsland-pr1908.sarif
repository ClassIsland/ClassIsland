                "region": {
                  "startLine": 267,
                  "endLine": 321,
                  "snippet": {
                    "text": "private void RenderFrame()\n    {\n        if (_frame == null || _island == null || _stage == null || _hostView == null)\n        {\n            return;\n        }\n\n        if (FindWindow() is { } window)\n        {\n            if (_hostView.Superview == null)\n            {\n                window.InsertSubview(_hostView, 0);\n            }\n\n            // 主题会按顶层宽度限制提醒宽度（Rectangles 主题取 80%），宿主视图必须与屏幕同宽，并跟随旋转。\n            if (_hostView.Frame != window.Bounds)\n            {\n                _hostView.Frame = window.Bounds;\n            }\n"
                  }
                },
                "contextRegion": {
                  "startLine": 267,
                  "endLine": 321,
                  "snippet": {
                    "text": "@@ -0,1 +266,57 @@\n+\n+    private void RenderFrame()\n+    {\n+        if (_frame == null || _island == null || _stage == null || _hostView == null)\n+        {\n+            return;\n+        }\n+\n+        if (FindWindow() is { } window)\n+        {\n+            if (_hostView.Superview == null)\n+            {\n+                window.InsertSubview(_hostView, 0);\n+            }\n+\n+            // 主题会按顶层宽度限制提醒宽度（Rectangles 主题取 80%），宿主视图必须与屏幕同宽，并跟随旋转。\n+            if (_hostView.Frame != window.Bounds)\n+            {\n+                _hostView.Frame = window.Bounds;\n+            }\n+\n+            if (_isFirstTapStartPending)\n+            {\n+                _isFirstTapStartPending = false;\n+                ArmFirstTapStart(window);\n+            }\n+        }\n+\n+        if (!_isPrepared)\n+        {\n+            var prepareResult = IosPipNativeBridge.Prepare();\n+            if (prepareResult != IosPipNativeBridge.Ok)\n+            {\n+                // 窗口尚未就绪时会返回 NotPrepared，下一帧重试即可；仍记录一次，便于排查一直准备不了的情况。\n+                LogOnce($\"无法准备画中画（{prepareResult}）：{IosPipNativeBridge.GetLastError()}\");\n+                return;\n+            }\n+"
                  }
                }
              },
              "logicalLocations": [
