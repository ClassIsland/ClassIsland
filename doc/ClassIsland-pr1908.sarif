                  "snippet": {
                    "text": "private async void MenuItemExportDiagnosticInfo_OnClick(object sender, RoutedEventArgs e)\n    {\n    // ... [25 unchanged lines omitted: L736-L760] ...\n\n            this.ShowToast(message);\n            PopupHelper.DisableAllPopups();\n            string? file;\n            try\n            {\n                var topLevel = TopLevel.GetTopLevel(this)!;\n                var options = new FilePickerSaveOptions\n                {\n                    Title = \"导出诊断数据\",\n                    SuggestedStartLocation =\n                        await topLevel.StorageProvider.TryGetFolderFromPathAsync(\n                            Environment.GetFolderPath(Environment.SpecialFolder.Desktop)),\n                    FileTypeChoices =\n                    [\n                        new FilePickerFileType(\"压缩文件\")\n                        {"
