                "region": {
                  "startLine": 149,
                  "endLine": 154,
                  "snippet": {
                    "text": "internal static string TrimText(string? text)\n    {\n        var trimmed = text?.Trim() ?? string.Empty;\n        var elements = StringInfo.ParseCombiningCharacters(trimmed);\n        return elements.Length <= 48 ? trimmed : trimmed[..elements[47]] + \"…\";\n    }"
                  }
                },
                "contextRegion": {
                  "startLine": 149,
                  "endLine": 154,
                  "snippet": {
                    "text": "@@ -0,1 +148,8 @@\n+\n+    internal static string TrimText(string? text)\n+    {\n+        var trimmed = text?.Trim() ?? string.Empty;\n+        var elements = StringInfo.ParseCombiningCharacters(trimmed);\n+        return elements.Length <= 48 ? trimmed : trimmed[..elements[47]] + \"…\";\n+    }\n+}"
                  }
                }
              },
