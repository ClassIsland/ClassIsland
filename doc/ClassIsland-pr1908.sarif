                  "startLine": 99,
                  "endLine": 110,
                  "snippet": {
                    "text": "private void OnSettingsReplaced(object? sender, PropertyChangedEventArgs args)\n    {\n        if (args.PropertyName == nameof(SettingsService.Settings))\n        {\n            Dispatcher.UIThread.Post(() =>\n            {\n                if (_disposed) return;\n                ObserveSettings();\n                QueueRefresh();\n            });\n        }\n    }"
                  }
                },
                "contextRegion": {
                  "startLine": 99,
                  "endLine": 110,
                  "snippet": {
                    "text": "@@ -0,1 +98,14 @@\n+\n+    private void OnSettingsReplaced(object? sender, PropertyChangedEventArgs args)\n+    {\n+        if (args.PropertyName == nameof(SettingsService.Settings))\n+        {\n+            Dispatcher.UIThread.Post(() =>\n+            {\n+                if (_disposed) return;\n+                ObserveSettings();\n+                QueueRefresh();\n+            });\n+        }\n+    }\n+"
                  }
                }
              },
