                    "text": "internal static void EnsureFileIsNotLink(string path)\n    {\n        if (!File.Exists(path))\n        {\n            throw new FileNotFoundException(\"找不到文件。\", path);\n        }\n\n        RejectReparsePoint(path);\n    }"
                  }
                },
