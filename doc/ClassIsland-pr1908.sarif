                "region": {
                  "startLine": 19,
                  "endLine": 24,
                  "snippet": {
                    "text": "public IosAccentPickerService(SettingsService settingsService, ILogger<AccentPickerSession> logger)\n    {\n        _session = new AccentPickerSession(settingsService, logger, SupportsWallpaper, SupportsScreen,\n            (_, _) => Task.FromResult(new AccentPickResult(AccentPickStatus.Unavailable)));\n        _session.PropertyChanged += (_, e) => PropertyChanged?.Invoke(this, e);\n    }"
                  }
                },
                "contextRegion": {
                  "startLine": 19,
                  "endLine": 24,
                  "snippet": {
                    "text": "@@ -0,1 +18,8 @@\n+\n+    public IosAccentPickerService(SettingsService settingsService, ILogger<AccentPickerSession> logger)\n+    {\n+        _session = new AccentPickerSession(settingsService, logger, SupportsWallpaper, SupportsScreen,\n+            (_, _) => Task.FromResult(new AccentPickResult(AccentPickStatus.Unavailable)));\n+        _session.PropertyChanged += (_, e) => PropertyChanged?.Invoke(this, e);\n+    }\n+"
                  }
                }
              },
