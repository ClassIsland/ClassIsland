                  "startLine": 10,
                  "endLine": 21,
                  "snippet": {
                    "text": "public IosDeviceInfoService()\n    {\n        try\n        {\n            // 在平台入口的主线程读取 UIKit，诊断导出时可从后台线程访问缓存。\n            _model = UIDevice.CurrentDevice.Model;\n        }\n        catch\n        {\n            // 设备信息仅用于诊断，查询失败时不影响应用运行。\n        }\n    }"
                  }
                },
                "contextRegion": {
                  "startLine": 10,
                  "endLine": 21,
                  "snippet": {
                    "text": "@@ -0,1 +9,14 @@\n+\n+    public IosDeviceInfoService()\n+    {\n+        try\n+        {\n+            // 在平台入口的主线程读取 UIKit，诊断导出时可从后台线程访问缓存。\n+            _model = UIDevice.CurrentDevice.Model;\n+        }\n+        catch\n+        {\n+            // 设备信息仅用于诊断，查询失败时不影响应用运行。\n+        }\n+    }\n+"
                  }
                }
              },
