                "region": {
                  "startLine": 616,
                  "endLine": 676,
                  "snippet": {
                    "text": "public async Task EndCurrentAsync(CancellationToken cancellationToken)\n    {\n        if (Volatile.Read(ref _isStopping) != 0)\n        {\n            return;\n        }\n\n        Interlocked.Exchange(ref _isPublicationPaused, 1);\n        lock (_refreshTimerLock)\n        {\n            _refreshTimer?.Change(\n                Timeout.InfiniteTimeSpan,\n                Timeout.InfiniteTimeSpan);\n        }\n\n        var gateEntered = false;\n        using var timeoutCancellation =\n            CancellationTokenSource.CreateLinkedTokenSource(\n                cancellationToken,\n                _cancellation.Token);"
                  }
                },
                "contextRegion": {
                  "startLine": 616,
                  "endLine": 676,
                  "snippet": {
                    "text": "@@ -0,1 +615,63 @@\n+\n+    public async Task EndCurrentAsync(CancellationToken cancellationToken)\n+    {\n+        if (Volatile.Read(ref _isStopping) != 0)\n+        {\n+            return;\n+        }\n+\n+        Interlocked.Exchange(ref _isPublicationPaused, 1);\n+        lock (_refreshTimerLock)\n+        {\n+            _refreshTimer?.Change(\n+                Timeout.InfiniteTimeSpan,\n+                Timeout.InfiniteTimeSpan);\n+        }\n+\n+        var gateEntered = false;\n+        using var timeoutCancellation =\n+            CancellationTokenSource.CreateLinkedTokenSource(\n+                cancellationToken,\n+                _cancellation.Token);\n+        timeoutCancellation.CancelAfter(ManualTerminationTimeout);\n+        try\n+        {\n+            await _refreshGate.WaitAsync(timeoutCancellation.Token);\n+            gateEntered = true;\n+            var result = await liveActivityService.EndAsync(\n+                LiveActivityDismissalPolicy.Immediate,\n+                timeoutCancellation.Token);\n+            if (result.IsSuccess)\n+            {\n+                _lastRequestedContent = null;\n+                _activityStateKnown = true;\n+                _hasVisibleActivity = false;\n+ "
                  }
                }
              },
