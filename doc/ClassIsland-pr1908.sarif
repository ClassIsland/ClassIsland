                },
                "region": {
                  "startLine": 195,
                  "endLine": 199,
                  "snippet": {
                    "text": "private void RunMainViewCommand(Func<MainView, Task> command)\n    {\n        if (_isHudProcess || !_isAppNavigationReady || _systemNavigationService is not { } service) return;\n        Dispatcher.UIThread.Post(async () => await service.RunMainViewCommandAsync(command));\n    }"
                  }
                },
                "contextRegion": {
                  "startLine": 195,
                  "endLine": 199,
                  "snippet": {
                    "text": "@@ -0,1 +194,7 @@\n+\n+    private void RunMainViewCommand(Func<MainView, Task> command)\n+    {\n+        if (_isHudProcess || !_isAppNavigationReady || _systemNavigationService is not { } service) return;\n+        Dispatcher.UIThread.Post(async () => await service.RunMainViewCommandAsync(command));\n+    }\n+}"
                  }
                }
              },
