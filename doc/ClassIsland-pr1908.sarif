                "region": {
                  "startLine": 144,
                  "endLine": 188,
                  "snippet": {
                    "text": "private static bool TryGetAppleDocumentsIndex(\n        IReadOnlyList<string> pathSegments,\n        out int documentsIndex)\n    {\n        documentsIndex = -1;\n        var offset = pathSegments.Count > 0 &&\n                     string.Equals(\n                         pathSegments[0],\n                         \"private\",\n                         StringComparison.Ordinal)\n            ? 1\n            : 0;\n        if (pathSegments.Count <= offset + 6 ||\n            !string.Equals(\n                pathSegments[offset],\n                \"var\",\n                StringComparison.Ordinal) ||\n            !string.Equals(\n                pathSegments[offset + 1],\n                \"mobile\","
                  }
                },
                "contextRegion": {
                  "startLine": 144,
                  "endLine": 188,
                  "snippet": {
                    "text": "@@ -0,1 +143,47 @@\n+\n+    private static bool TryGetAppleDocumentsIndex(\n+        IReadOnlyList<string> pathSegments,\n+        out int documentsIndex)\n+    {\n+        documentsIndex = -1;\n+        var offset = pathSegments.Count > 0 &&\n+                     string.Equals(\n+                         pathSegments[0],\n+                         \"private\",\n+                         StringComparison.Ordinal)\n+            ? 1\n+            : 0;\n+        if (pathSegments.Count <= offset + 6 ||\n+            !string.Equals(\n+                pathSegments[offset],\n+                \"var\",\n+                StringComparison.Ordinal) ||\n+            !string.Equals(\n+                pathSegments[offset + 1],\n+                \"mobile\",\n+                StringComparison.Ordinal) ||\n+            !string.Equals(\n+                pathSegments[offset + 2],\n+                \"Containers\",\n+                StringComparison.Ordinal) ||\n+            !string.Equals(\n+                pathSegments[offset + 3],\n+                \"Data\",\n+                StringComparison.Ordinal) ||\n+            !string.Equals(\n+                pathSegments[offset + 4],\n+                \"Application\",\n+                StringCompariso"
                  }
                }
              },
