                "region": {
                  "startLine": 350,
                  "endLine": 362,
                  "snippet": {
                    "text": "private static bool IsSameOrDescendant(string path, string root)\n    {\n        var fullPath = Path.GetFullPath(path);\n        var fullRoot = Path.TrimEndingDirectorySeparator(\n            Path.GetFullPath(root));\n        var comparison = OperatingSystem.IsWindows()\n            ? StringComparison.OrdinalIgnoreCase\n            : StringComparison.Ordinal;\n        return string.Equals(fullPath, fullRoot, comparison) ||\n               fullPath.StartsWith(\n                   fullRoot + Path.DirectorySeparatorChar,\n                   comparison);\n    }"
                  }
                },
                "contextRegion": {
                  "startLine": 350,
                  "endLine": 362,
                  "snippet": {
                    "text": "@@ -78,1 +349,15 @@ public partial class StorageSettingsPage : SettingsPageBase\n+\n+    private static bool IsSameOrDescendant(string path, string root)\n+    {\n+        var fullPath = Path.GetFullPath(path);\n+        var fullRoot = Path.TrimEndingDirectorySeparator(\n+            Path.GetFullPath(root));\n+        var comparison = OperatingSystem.IsWindows()\n+            ? StringComparison.OrdinalIgnoreCase\n+            : StringComparison.Ordinal;\n+        return string.Equals(fullPath, fullRoot, comparison) ||\n+               fullPath.StartsWith(\n+                   fullRoot + Path.DirectorySeparatorChar,\n+                   comparison);\n+    }\n+"
                  }
                }
              },
