                    "text": "@@ -0,1 +92,49 @@\n+/// 返回 1 表示已注册；旧系统或旧 SDK 返回 0，由宿主继续使用 buildMenu(with:)。\n+@_cdecl(\"ci_system_integration_install_main_menu\")\n+public func ci_system_integration_install_main_menu() -> Int32 {\n+#if compiler(>=6.2)\n+    guard #available(iOS 26.0, *) else {\n+        mainMenuStatus = \"skipped: system older than iOS 26\"\n+        return 0\n+    }\n+    guard Thread.isMainThread else {\n+        mainMenuStatus = \"skipped: not on main thread\"\n+        return 0\n+    }\n+    // 构建处理程序可能在 setBuildConfiguration 内同步执行，必须先写入等待状态，避免覆盖构建结果。\n+    mainMenuStatus = \"installed, waiting for build\"\n+    MainActor.assumeIsolated {\n+        UIMainMenuSystem.shared.setBuildConfiguration(UIMainMenuSystem.Configuration()) { builder in\n+            mainMenuBuildCount += 1\n+            // UIMenuBuilder 会静默丢弃快捷键与已有命令重复的菜单；失败时改用不带快捷键的版本，保证菜单可见。\n+            let scheduleId = UIMenu.Identifier(\"cn.classisland.schedule\")\n+            builder.insertSibling(classIslandScheduleMenu(withShortcuts: true), afterMenu: .view)\n+            var scheduleResult = builder.menu(for: scheduleId) != nil ? \"ok\" : \"fallback\"\n+            if scheduleResult == \"fallback\" {\n+                builder.insertSibling(classIslandScheduleMenu(wi"
