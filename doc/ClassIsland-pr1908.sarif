                  "snippet": {
                    "text": "private async void MenuItemOpenAppFolder_OnClick(object sender, RoutedEventArgs e)\n    {\n        var folderPath = PlatformHelper.IsAppleMobile\n            ? CommonDirectories.AppSharedDocumentsFolderPath\n            : \".\";\n        await OpenFolderAsync(folderPath, \"应用目录\");\n    }"
                  }
                },
                "contextRegion": {
                  "startLine": 843,
