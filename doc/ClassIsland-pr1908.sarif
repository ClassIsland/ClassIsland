                "region": {
                  "startLine": 20,
                  "endLine": 29,
                  "snippet": {
                    "text": "public void PlayScrollBoundary() => Dispatcher.UIThread.Post(() =>\n    {\n        if (UIApplication.SharedApplication.ApplicationState != UIApplicationState.Active)\n        {\n            return;\n        }\n\n        using var feedback = new UIImpactFeedbackGenerator(UIImpactFeedbackStyle.Soft);\n        feedback.ImpactOccurred();\n    });"
                  }
                },
                "contextRegion": {
                  "startLine": 20,
