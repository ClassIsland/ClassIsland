                  "startLine": 124,
                  "endLine": 130,
                  "snippet": {
                    "text": "private void QueueRefresh(bool reloadWidgets = false) => Dispatcher.UIThread.Post(() =>\n    {\n        if (_disposed) return;\n        // 小组件可能缓存了读取失败时的时间线，快照未变时原生层不会主动刷新。\n        _shouldReloadWidgets |= reloadWidgets;\n        if (!_debounceTimer.IsEnabled) _debounceTimer.Start();\n    });"
                  }
                },
                "contextRegion": {
                  "startLine": 124,
                  "endLine": 130,
                  "snippet": {
                    "text": "@@ -0,1 +123,9 @@\n+\n+    private void QueueRefresh(bool reloadWidgets = false) => Dispatcher.UIThread.Post(() =>\n+    {\n+        if (_disposed) return;\n+        // 小组件可能缓存了读取失败时的时间线，快照未变时原生层不会主动刷新。\n+        _shouldReloadWidgets |= reloadWidgets;\n+        if (!_debounceTimer.IsEnabled) _debounceTimer.Start();\n+    });\n+"
                  }
                }
              },
