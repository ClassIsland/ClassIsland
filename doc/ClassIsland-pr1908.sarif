                    "text": "private void OnRefreshTimer(object? state)\n    {\n        if (_cancellation.IsCancellationRequested ||\n            Volatile.Read(ref _isStopping) != 0)\n        {\n            return;\n        }\n\n        Dispatcher.UIThread.Post(QueueRefresh);\n    }"
