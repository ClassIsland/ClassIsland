                "region": {
                  "startLine": 413,
                  "endLine": 422,
                  "snippet": {
                    "text": "private async Task CompleteNotificationAsync(QueuedNotification notification)\n    {\n        if (Dispatcher.UIThread.CheckAccess())\n        {\n            CompleteNotificationCore(notification);\n            return;\n        }\n\n        await Dispatcher.UIThread.InvokeAsync(() => CompleteNotificationCore(notification));\n    }"
                  }
                },
                "contextRegion": {
                  "startLine": 413,
                  "endLine": 422,
                  "snippet": {
                    "text": "@@ -0,1 +412,12 @@\n+\n+    private async Task CompleteNotificationAsync(QueuedNotification notification)\n+    {\n+        if (Dispatcher.UIThread.CheckAccess())\n+        {\n+            CompleteNotificationCore(notification);\n+            return;\n+        }\n+\n+        await Dispatcher.UIThread.InvokeAsync(() => CompleteNotificationCore(notification));\n+    }\n+"
                  }
                }
              },
