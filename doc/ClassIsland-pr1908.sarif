                "region": {
                  "startLine": 72,
                  "endLine": 101,
                  "snippet": {
                    "text": "public async Task<List<Uri>> OpenBlobFilesPickerAsync(BlobFilePickerOpenOptions options, TopLevel root)\n    {\n        ArgumentNullException.ThrowIfNull(options);\n        ArgumentOutOfRangeException.ThrowIfNegative(options.MaxFileSize);\n\n        var maxFileSize = options.MaxFileSize;\n        var files = await OpenBlobStorageFilesPickerAsync(options, root);\n        try\n        {\n            var result = new List<Uri>();\n            var blobRoot = Path.GetFullPath(PlatformServices.BlobRootFolderPath);\n            foreach (var file in files)\n            {\n                await using var stream = await file.OpenReadAsync();\n                if (await StoreBlobAsync(stream, maxFileSize, blobRoot) is { } uri)\n                {\n                    result.Add(uri);\n                }\n            }\n"
                  }
                },
                "contextRegion": {
                  "startLine": 72,
                  "endLine": 101,
                  "snippet": {
                    "text": "@@ -43,3 +71,3 @@ public class AvaloniaDefaultPlatformFilePickerService : IPlatformFilePickerServi\n     /// <inheritdoc />\n     public async Task<List<Uri>> OpenBlobFilesPickerAsync(BlobFilePickerOpenOptions options, TopLevel root)\n     {\n@@ -47,7 +75,7 @@ public class AvaloniaDefaultPlatformFilePickerService : IPlatformFilePickerServi\n         ArgumentOutOfRangeException.ThrowIfNegative(options.MaxFileSize);\n \n         var maxFileSize = options.MaxFileSize;\n-        var files = await root.StorageProvider.OpenFilePickerAsync(options);\n+        var files = await OpenBlobStorageFilesPickerAsync(options, root);\n         try\n         {\n             var result = new List<Uri>();\n@@ -72,3 +100,3 @@ public class AvaloniaDefaultPlatformFilePickerService : IPlatformFilePickerServi\n         }\n     }\n "
                  }
                }
              },
