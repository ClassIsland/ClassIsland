                  "endLine": 51,
                  "snippet": {
                    "text": "internal static void TryDeleteTemporaryDirectory(string path)\n    {\n        try\n        {\n            Directory.Delete(path, true);\n        }\n        catch\n        {\n            // 临时目录残留不应覆盖导出阶段的成功结果或原始异常。\n        }\n    }"
                  }
                },
