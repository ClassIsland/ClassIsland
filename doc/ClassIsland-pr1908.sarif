                "region": {
                  "startLine": 63,
                  "endLine": 79,
                  "snippet": {
                    "text": "private static void DeleteOperationDirectories(IEnumerable<string> paths)\n    {\n        foreach (var directory in paths\n                     .Select(Path.GetDirectoryName)\n                     .OfType<string>()\n                     .Distinct(StringComparer.Ordinal))\n        {\n            try\n            {\n                Directory.Delete(directory, true);\n            }\n            catch\n            {\n                // 保留原始导入异常。\n            }\n        }\n    }"
                  }
                },
                "contextRegion": {
                  "startLine": 63,
                  "endLine": 79,
                  "snippet": {
                    "text": "@@ -0,1 +62,19 @@\n+\n+    private static void DeleteOperationDirectories(IEnumerable<string> paths)\n+    {\n+        foreach (var directory in paths\n+                     .Select(Path.GetDirectoryName)\n+                     .OfType<string>()\n+                     .Distinct(StringComparer.Ordinal))\n+        {\n+            try\n+            {\n+                Directory.Delete(directory, true);\n+            }\n+            catch\n+            {\n+                // 保留原始导入异常。\n+            }\n+        }\n+    }\n+}"
                  }
                }
              },
