                  "snippet": {
                    "text": "private void OnSystemTimeChanged(object? sender, EventArgs e)\n    {\n        Dispatcher.UIThread.Post(() =>\n        {\n            _lastRequestedContent = null;\n            _retryAfter = default;\n            _activityStateKnown = false;\n            QueueRefresh();\n        });\n    }"
