                },
                "region": {
                  "startLine": 207,
                  "endLine": 236,
                  "snippet": {
                    "text": "private void CreateHost()\n    {\n        _island = new IosMainWindowIslandView();\n        _stage = new Canvas();\n        _stage.Children.Add(_island);\n        _frame = new Border\n        {\n            Background = Brushes.Black,\n            Width = _canvasSize.Width,\n            Height = _canvasSize.Height,\n            Child = _stage\n        };\n        // 外层 Canvas 以无限尺寸测量子元素，主界面岛可以按自然宽度排版而不受宿主视图尺寸限制。\n        var root = new Canvas();\n        root.Children.Add(_frame);\n        _hostView = new AvaloniaView\n        {\n            Frame = FindWindow()?.Bounds ?? new CGRect(0, 0, FallbackScreenWidth, FallbackScreenWidth),\n            Alpha = 0,\n            UserInteractionEnabled = false,"
                  }
                },
                "contextRegion": {
                  "startLine": 207,
                  "endLine": 236,
                  "snippet": {
                    "text": "@@ -0,1 +206,32 @@\n+    /// </summary>\n+    private void CreateHost()\n+    {\n+        _island = new IosMainWindowIslandView();\n+        _stage = new Canvas();\n+        _stage.Children.Add(_island);\n+        _frame = new Border\n+        {\n+            Background = Brushes.Black,\n+            Width = _canvasSize.Width,\n+            Height = _canvasSize.Height,\n+            Child = _stage\n+        };\n+        // 外层 Canvas 以无限尺寸测量子元素，主界面岛可以按自然宽度排版而不受宿主视图尺寸限制。\n+        var root = new Canvas();\n+        root.Children.Add(_frame);\n+        _hostView = new AvaloniaView\n+        {\n+            Frame = FindWindow()?.Bounds ?? new CGRect(0, 0, FallbackScreenWidth, FallbackScreenWidth),\n+            Alpha = 0,\n+            UserInteractionEnabled = false,\n+            Content = root\n+        };\n+        // 画面由 RenderTargetBitmap 在 UI 线程渲染，布局也由帧循环手动执行，这个不可见视图不需要自己的合成渲染。\n+        // 让它继续渲染会和应用主界面争用同一个渲染线程，并向一个看不见的 Metal 图层提交画面。\n+        if (TopLevel.GetTopLevel(root) is EmbeddableControlRoot hostRoot)\n+        {\n+            hostRoot.StopRendering();\n+        }\n+        FindWindow()?.InsertSubview(_hostView, 0);\n+    }\n+"
                  }
                }
              },
