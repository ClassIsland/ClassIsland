                    "text": "internal static void TryDeleteFile(string path)\n    {\n        try\n        {\n            File.Delete(path);\n        }\n        catch\n        {\n            // 保留原始导入异常；残留内容可由用户在 iOS 存储设置中清理。\n        }\n    }"
