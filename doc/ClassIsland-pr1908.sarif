                "region": {
                  "startLine": 256,
                  "endLine": 316,
                  "snippet": {
                    "text": "private void EnsureHudWindow(ISingleViewApplicationLifetime lifetime)\n    {\n        if (_hudWindow != null || TopLevel.GetTopLevel(_hudHost!) != null)\n        {\n            return;\n        }\n\n        try\n        {\n            var sceneDelegateType = typeof(AvaloniaView).Assembly.GetType(\"Avalonia.iOS.AvaloniaSceneDelegate\");\n            var initWindow = sceneDelegateType?.GetMethod(\n                \"InitWindow\",\n                BindingFlags.Static | BindingFlags.NonPublic | BindingFlags.Public);\n            if (initWindow == null)\n            {\n                IosStartupDiagnostics.Write(\"HUD mode: 找不到 AvaloniaSceneDelegate.InitWindow，无法创建悬浮窗\");\n                return;\n            }\n\n            // 直接以 HUD 窗口子类创建窗口（等价于参考实现的 alloc/init HUDWindow 子类），"
                  }
                },
                "contextRegion": {
                  "startLine": 256,
                  "endLine": 316,
                  "snippet": {
                    "text": "@@ -0,1 +255,63 @@\n+    /// </summary>\n+    private void EnsureHudWindow(ISingleViewApplicationLifetime lifetime)\n+    {\n+        if (_hudWindow != null || TopLevel.GetTopLevel(_hudHost!) != null)\n+        {\n+            return;\n+        }\n+\n+        try\n+        {\n+            var sceneDelegateType = typeof(AvaloniaView).Assembly.GetType(\"Avalonia.iOS.AvaloniaSceneDelegate\");\n+            var initWindow = sceneDelegateType?.GetMethod(\n+                \"InitWindow\",\n+                BindingFlags.Static | BindingFlags.NonPublic | BindingFlags.Public);\n+            if (initWindow == null)\n+            {\n+                IosStartupDiagnostics.Write(\"HUD mode: 找不到 AvaloniaSceneDelegate.InitWindow，无法创建悬浮窗\");\n+                return;\n+            }\n+\n+            // 直接以 HUD 窗口子类创建窗口（等价于参考实现的 alloc/init HUDWindow 子类），\n+            // 而不是先 new UIWindow 再 object_setClass。\n+            var bounds = UIScreen.MainScreen.Bounds;\n+            var handle = IosHudNativeBridge.CreateWindow(bounds.X, bounds.Y, bounds.Width, bounds.Height);\n+            if (handle == 0)\n+            {\n+                IosStartupDiagnostics.Write(\n+                    $\"HUD mode: 原生创建悬浮窗失败：{IosHudNativeBridge.GetLastE"
                  }
                }
              },
