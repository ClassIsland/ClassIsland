                  "endLine": 236,
                  "snippet": {
                    "text": "private static void ValidateRelativeSegments(IReadOnlyList<string> segments)\n    {\n        if (segments.Count == 0 || segments.Any(segment =>\n                string.IsNullOrWhiteSpace(segment) ||\n                segment is \".\" or \"..\" ||\n                segment.Contains('/') ||\n                segment.Contains('\\\\') ||\n                segment.IndexOf('\\0') >= 0))\n        {\n            throw new FormatException(\"导入文件引用包含无效路径。\");\n        }\n    }"
                  }
                },
                "contextRegion": {
                  "startLine": 225,
                  "endLine": 236,
                  "snippet": {
