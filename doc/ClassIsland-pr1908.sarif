{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "CPS",
          "fullName": "CPS v5.7.0 — Polyglot Consistency & Persistence Gate",
          "version": "5.7.0",
          "semanticVersion": "5.7.0",
          "informationUri": "https://github.com/scip-code/scip",
          "rules": [
            {
              "id": "CPS001",
              "name": "CriticalGateBlock",
              "shortDescription": {
                "text": "Critical consistency, persistence, or security gate block"
              },
              "fullDescription": {
                "text": "The semantic unit critically violates repository safety, hygiene, or composite CPS thresholds."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "help": {
                "text": "Resolve security/conflict hazards and align complexity and conventions with upstream baseline.",
                "markdown": "**Critical Gate Block (`CPS001`)**: Resolve merge conflicts, hardcoded credentials, or severe complexity regressions."
              },
              "properties": {
                "tags": [
                  "maintainability",
                  "reliability",
                  "cps-gate"
                ],
                "problem.severity": "error"
              }
            },
            {
              "id": "CPS002",
              "name": "ConsistencyDrift",
              "shortDescription": {
                "text": "Code style, naming, or AST topology diverges from upstream conventions"
              },
              "fullDescription": {
                "text": "Unit consistency score (AST structure, CLAVE stylometry, CodeT5 authorship, or identifier casing) fell below gate threshold."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "help": {
                "text": "Match naming casing, indentation/brace rhythm, and control-flow idioms of cited upstream exemplars.",
                "markdown": "**Consistency Drift (`CPS002`)**: Align naming and control-flow structure with the cited upstream reference functions."
              },
              "properties": {
                "tags": [
                  "consistency",
                  "style",
                  "conventions"
                ],
                "problem.severity": "warning"
              }
            },
            {
              "id": "CPS003",
              "name": "IncrementalComplexityRegression",
              "shortDescription": {
                "text": "Incremental edit introduced excessive cognitive complexity or nesting"
              },
              "fullDescription": {
                "text": "Net marginal cognitive complexity, nesting depth, or SLOC added by this change exceeded calibrated thresholds."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "help": {
                "text": "Flatten nested conditionals into early-return guard clauses or extract cohesive helper methods.",
                "markdown": "**Complexity Regression (`CPS003`)**: Flatten deeply nested branches using defensive early-return guard clauses."
              },
              "properties": {
                "tags": [
                  "maintainability",
                  "complexity"
                ],
                "problem.severity": "warning"
              }
            },
            {
              "id": "CPS004",
              "name": "BreakingSignatureContractChange",
              "shortDescription": {
                "text": "Breaking callable signature transition affecting SCIP upstream callers"
              },
              "fullDescription": {
                "text": "A public or cross-referenced callable changed arity or name in a way that risks breaking existing callers."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "help": {
                "text": "Provide a backward-compatible overload or default parameter value for existing SCIP callers.",
                "markdown": "**Breaking Signature (`CPS004`)**: Preserve caller compatibility via overloads or optional default arguments."
              },
              "properties": {
                "tags": [
                  "api-contract",
                  "scip-impact"
                ],
                "problem.severity": "warning"
              }
            },
            {
              "id": "CPS005",
              "name": "WheelReinventingDuplicateLogic",
              "shortDescription": {
                "text": "Newly added function duplicates existing upstream utility logic"
              },
              "fullDescription": {
                "text": "Neural and alpha-normalized AST skeleton analysis matched an existing upstream utility implementation."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "help": {
                "text": "Reuse or parameterize the existing upstream utility identified in relatedLocations.",
                "markdown": "**Semantic Duplicate (`CPS005`)**: Reuse or extend the matched upstream helper instead of re-implementing identical logic."
              },
              "properties": {
                "tags": [
                  "duplication",
                  "reuse"
                ],
                "problem.severity": "recommendation"
              }
            },
            {
              "id": "CPS006",
              "name": "DuplicateCallableSignatureCollision",
              "shortDescription": {
                "text": "Callable signature contract collides with an existing upstream helper"
              },
              "fullDescription": {
                "text": "Normalized parameter types, return type, and action-noun stem collide with an existing upstream callable."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "help": {
                "text": "Consolidate redundant helper contracts into a single shared module.",
                "markdown": "**Duplicate Signature (`CPS006`)**: Consolidate colliding callable contracts with the upstream method."
              },
              "properties": {
                "tags": [
                  "duplication",
                  "api-design"
                ],
                "problem.severity": "recommendation"
              }
            },
            {
              "id": "CPS007",
              "name": "CrossLayerArchitectureOrDiViolation",
              "shortDescription": {
                "text": "Upward cross-layer dependency or constructor DI over-injection"
              },
              "fullDescription": {
                "text": "A lower-tier module referenced a higher-tier UI/ViewModel type, or a constructor injected >=7 dependencies."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "help": {
                "text": "Invert upward dependencies behind a domain/service interface and split god-class dependencies.",
                "markdown": "**Architectural Boundary (`CPS007`)**: Invert upward layer dependencies using interfaces."
              },
              "properties": {
                "tags": [
                  "architecture",
                  "solid",
                  "dependency-injection"
                ],
                "problem.severity": "error"
              }
            },
            {
              "id": "CPS008",
              "name": "EvolutionaryCoChangeOmission",
              "shortDescription": {
                "text": "Historically coupled companion file was not updated in this changeset"
              },
              "fullDescription": {
                "text": "Git temporal coupling history indicates high conditional probability that a companion file co-changes with the modified file."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "help": {
                "text": "Verify whether the companion view, ViewModel, DTO, or schema file requires a synchronized update.",
                "markdown": "**Co-Change Omission (`CPS008`)**: Check whether the historically coupled companion file also needs updating."
              },
              "properties": {
                "tags": [
                  "temporal-coupling",
                  "completeness"
                ],
                "problem.severity": "recommendation"
              }
            },
            {
              "id": "CPS009",
              "name": "RuntimeEffectOrAsyncHazard",
              "shortDescription": {
                "text": "Sync-over-async deadlock risk, async void, swallowed catch, or contract regression"
              },
              "fullDescription": {
                "text": "Detected blocking `.Result`/`.Wait()`, non-event `async void`, swallowed catch block, or unguarded null/exception tightening."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "help": {
                "text": "Use `async Task` and `await`, log or propagate caught exceptions, and guard nullable returns.",
                "markdown": "**Runtime/Async Hazard (`CPS009`)**: Replace blocking calls and `async void` with `await` and `Task`."
              },
              "properties": {
                "tags": [
                  "concurrency",
                  "reliability",
                  "defensive-programming"
                ],
                "problem.severity": "warning"
              }
            },
            {
              "id": "CPS010",
              "name": "SecurityOrMergeConflictHazard",
              "shortDescription": {
                "text": "Hardcoded secret/token, merge conflict marker, or dynamic code execution"
              },
              "fullDescription": {
                "text": "Detected unresolved Git conflict markers, credential/private-key patterns, or unsafe `eval`/`exec` invocation."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "help": {
                "text": "Remove secrets immediately, resolve conflict markers, and eliminate dynamic code execution.",
                "markdown": "**Security/Hygiene Hazard (`CPS010`)**: Strip secrets, resolve conflict markers, and avoid `eval`/`exec`."
              },
              "properties": {
                "tags": [
                  "security",
                  "hygiene"
                ],
                "security-severity": "8.5",
                "problem.severity": "error"
              }
            }
          ]
        }
      },
