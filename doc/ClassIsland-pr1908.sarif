                  "snippet": {
                    "text": "@_cdecl(\"ci_pip_prepare\")\npublic func ci_pip_prepare() -> Int32 {\n    let (controller, error) = pipController(\"ci_pip_prepare\")\n    guard let controller else {\n        return error.rawValue\n    }\n    return controller.prepare().rawValue\n}"
                  }
                },
                "contextRegion": {
                  "startLine": 410,
