                  "snippet": {
                    "text": "private func canUpdate(_ activity: LiveActivity) -> Bool {\n        if #available(iOS 16.2, *) {\n            switch activity.activityState {\n            case .active, .stale:\n                return true\n            case .dismissed, .ended, .pending:\n                return false\n            @unknown default:\n                return false\n            }\n        } else {\n            switch activity.activityState {\n            case .active:\n                return true\n            case .dismissed, .ended, .pending, .stale:\n                return false\n            @unknown default:\n                return false\n            }\n        }"
                  }
                },
                "contextRegion": {
                  "startLine": 296,
                  "endLine": 316,
                  "snippet": {
                    "text": "@@ -0,1 +295,23 @@\n+\n+    private func canUpdate(_ activity: LiveActivity) -> Bool {\n+        if #available(iOS 16.2, *) {\n+            switch activity.activityState {\n+            case .active, .stale:\n+                return true\n+            case .dismissed, .ended, .pending:\n+                return false\n+            @unknown default:\n+                return false\n+            }\n+        } else {\n+            switch activity.activityState {\n+            case .active:\n+                return true\n+            case .dismissed, .ended, .pending, .stale:\n+                return false\n+            @unknown default:\n+                return false\n+            }\n+        }\n+    }\n+"
                  }
                }
              },
