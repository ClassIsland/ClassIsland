          "ruleId": "CPS002",
          "ruleIndex": 1,
          "level": "note",
          "rank": 10.93,
          "message": {
            "text": "[提示] ci_hud_start — CPS=88.0% (C=83.4%, P=92.9%). 标识符 `ci_hud_start` (snake) 不符合 `camel` 命名规范 修复: 将 `ci_hud_start` 调整为 `camel` 命名格式。",
            "markdown": "**提示** — `ci_hud_start` (`ClassIsland.iOS.Native/Bridge/ClassIslandHudBridge.swift:L215-L235`) · **CPS `88.0%`** (C `83.4%`, P `92.9%`, 权重 `0.1%`)\n- **问题:** 标识符 `ci_hud_start` (snake) 不符合 `camel` 命名规范\n- **修复:** 将 `ci_hud_start` 调整为 `camel` 命名格式。"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "ClassIsland.iOS.Native/Bridge/ClassIslandHudBridge.swift",
                  "uriBaseId": "%SRCROOT%",
                  "index": 92
                },
                "region": {
                  "startLine": 215,
                  "endLine": 235,
                  "snippet": {
                    "text": "@_cdecl(\"ci_hud_start\")\npublic func ci_hud_start(_ spawnAsRoot: Int32, _ dataDirUTF8: UnsafePointer<CChar>?) -> Int32 {\n    guard let dataDirUTF8 else {\n        hudSetLastError(\"ci_hud_start: data_dir_utf8 不能为 NULL。\")\n        return HudError.invalidArgument.rawValue\n    }\n    let dataDir = String(cString: dataDirUTF8)\n    guard !dataDir.isEmpty else {\n        hudSetLastError(\"ci_hud_start: data_dir_utf8 不能为空字符串。\")\n        return HudError.invalidArgument.rawValue\n    }\n\n    hudStateLock.lock()\n    defer { hudStateLock.unlock() }\n\n    if hudResolveRunningPidLocked() > 0 {\n        hudClearLastError()\n        return HudError.ok.rawValue\n    }\n    return hudStartProcessLocked(spawnAsRoot: spawnAsRoot != 0, dataDir: dataDir)"
                  }
                },
                "contextRegion": {
                  "startLine": 215,
                  "endLine": 235,
                  "snippet": {
                    "text": "@@ -0,1 +214,23 @@\n+\n+@_cdecl(\"ci_hud_start\")\n+public func ci_hud_start(_ spawnAsRoot: Int32, _ dataDirUTF8: UnsafePointer<CChar>?) -> Int32 {\n+    guard let dataDirUTF8 else {\n+        hudSetLastError(\"ci_hud_start: data_dir_utf8 不能为 NULL。\")\n+        return HudError.invalidArgument.rawValue\n+    }\n+    let dataDir = String(cString: dataDirUTF8)\n+    guard !dataDir.isEmpty else {\n+        hudSetLastError(\"ci_hud_start: data_dir_utf8 不能为空字符串。\")\n+        return HudError.invalidArgument.rawValue\n+    }\n+\n+    hudStateLock.lock()\n+    defer { hudStateLock.unlock() }\n+\n+    if hudResolveRunningPidLocked() > 0 {\n+        hudClearLastError()\n+        return HudError.ok.rawValue\n+    }\n+    return hudStartProcessLocked(spawnAsRoot: spawnAsRoot != 0, dataDir: dataDir)\n+}\n+"
                  }
                }
              },
              "logicalLocations": [
                {
                  "name": "ci_hud_start",
                  "fullyQualifiedName": "ClassIsland.iOS.Native/Bridge/ClassIslandHudBridge.swift::ci_hud_start",
