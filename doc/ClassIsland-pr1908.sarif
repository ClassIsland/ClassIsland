                  "endLine": 126,
                  "snippet": {
                    "text": "@@ -0,1 +78,50 @@\n+\n+    private void SetEnabled(bool value, bool persist)\n+    {\n+        if (IosHudMode.IsHudProcess)\n+        {\n+            return;\n+        }\n+\n+        IosStartupDiagnostics.Write($\"悬浮主界面开关请求：{value}\");\n+\n+        if (value == _isEnabled)\n+        {\n+            if (persist)\n+            {\n+                PersistSetting(value);\n+            }\n+\n+            return;\n+        }\n+\n+        if (value)\n+        {\n+            if (!TryStartHud())\n+            {\n+                // 启动失败时通知 UI 回到未启用状态，避免开关显示为已开启但宿主并未运行。\n+                PropertyChanged?.Invoke(this, new PropertyChangedEventArgs(nameof(IsEnabled)));\n+                return;\n+            }\n+\n+            _isEnabled = true;\n+            SubscribeConfigurationChanges();\n+            ScheduleHudLivenessCheck();\n+        }\n+        else\n+        {\n+            _isEnabled = false;\n+            UnsubscribeConfigurationChanges();\n+            _livenessTimer?.Stop();"
                  }
                }
              },
              "logicalLocations": [
                {
                  "name": "SetEnabled",
                  "fullyQualifiedName": "ClassIsland.iOS/Services/Overlay/IosHudOverlayService.cs::SetEnabled",
                  "kind": "function"
                }
              ]
            }
