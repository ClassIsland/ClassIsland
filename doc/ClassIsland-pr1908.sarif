                },
                "region": {
                  "startLine": 18,
                  "endLine": 32,
                  "snippet": {
                    "text": "public Task<bool> RequestAuthorizationIfNeededAsync()\n    {\n        lock (_requestLock)\n        {\n            if (_requestTask != null)\n            {\n                return _requestTask;\n            }\n\n            var requestTask = RequestAuthorizationCoreAsync();\n            _requestTask = requestTask;\n            _ = ResetRequestTaskWhenCompletedAsync(requestTask);\n            return requestTask;\n        }\n    }"
                  }
                },
                "contextRegion": {
                  "startLine": 18,
                  "endLine": 32,
                  "snippet": {
                    "text": "@@ -0,1 +17,17 @@\n+    /// <returns>当前是否已获得通知授权。</returns>\n+    public Task<bool> RequestAuthorizationIfNeededAsync()\n+    {\n+        lock (_requestLock)\n+        {\n+            if (_requestTask != null)\n+            {\n+                return _requestTask;\n+            }\n+\n+            var requestTask = RequestAuthorizationCoreAsync();\n+            _requestTask = requestTask;\n+            _ = ResetRequestTaskWhenCompletedAsync(requestTask);\n+            return requestTask;\n+        }\n+    }\n+"
                  }
                }
              },
