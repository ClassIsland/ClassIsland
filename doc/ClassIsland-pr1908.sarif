                "region": {
                  "startLine": 234,
                  "endLine": 242,
                  "snippet": {
                    "text": "internal static void EnsureDirectoryIsNotLink(string path)\n    {\n        if (!Directory.Exists(path))\n        {\n            throw new DirectoryNotFoundException($\"找不到目录：{path}\");\n        }\n\n        RejectReparsePoint(path);\n    }"
                  }
                },
                "contextRegion": {
                  "startLine": 234,
                  "endLine": 242,
                  "snippet": {
                    "text": "@@ -0,1 +233,11 @@\n+\n+    internal static void EnsureDirectoryIsNotLink(string path)\n+    {\n+        if (!Directory.Exists(path))\n+        {\n+            throw new DirectoryNotFoundException($\"找不到目录：{path}\");\n+        }\n+\n+        RejectReparsePoint(path);\n+    }\n+"
                  }
