                  "startLine": 187,
                  "endLine": 200,
                  "snippet": {
                    "text": "private void OnSettingsServicePropertyChanged(object? sender, PropertyChangedEventArgs e)\n    {\n        if (e.PropertyName == nameof(SettingsService.Settings))\n        {\n            Dispatcher.UIThread.Post(() =>\n            {\n                if (Volatile.Read(ref _isStopping) == 0)\n                {\n                    SubscribeToSettings();\n                    QueueLessonsRefresh();\n                }\n            });\n        }\n    }"
                  }
                },
                "contextRegion": {
                  "startLine": 187,
