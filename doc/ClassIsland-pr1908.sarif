          "message": {
            "text": "[提示] ci_system_integration_consume_pending — CPS=87.1% (C=81.5%, P=92.9%). 标识符 `ci_system_integration_consume_pending` (snake) 不符合 `camel` 命名规范 修复: 将 `ci_system_integration_consume_pending` 调整为 `camel` 命名格式。",
            "markdown": "**提示** — `ci_system_integration_consume_pending` (`ClassIsland.iOS.Native/Bridge/ClassIslandSystemIntegrationBridge.swift:L192-L207`) · **CPS `87.1%`** (C `81.5%`, P `92.9%`, 权重 `0.1%`)\n- **问题:** 标识符 `ci_system_integration_consume_pending` (snake) 不符合 `camel` 命名规范\n- **修复:** 将 `ci_system_integration_consume_pending` 调整为 `camel` 命名格式。"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "ClassIsland.iOS.Native/Bridge/ClassIslandSystemIntegrationBridge.swift",
                  "uriBaseId": "%SRCROOT%",
                  "index": 95
                },
                "region": {
                  "startLine": 192,
                  "endLine": 207,
                  "snippet": {
                    "text": "@_cdecl(\"ci_system_integration_consume_pending\")\npublic func ci_system_integration_consume_pending() -> UnsafePointer<CChar>? {\n    systemIntegrationLock.lock()\n    defer { systemIntegrationLock.unlock() }\n    free(systemPendingCommand)\n    systemPendingCommand = nil\n    guard let url = try? ClassIslandSystemSnapshotStore.fileURL(\n        named: ClassIslandSystemSnapshotStore.pendingCommandFileName),\n          let command = try? String(contentsOf: url, encoding: .utf8),\n          let attributes = try? FileManager.default.attributesOfItem(atPath: url.path),\n          let modifiedAt = attributes[.modificationDate] as? Date else { return nil }\n    try? FileManager.default.removeItem(at: url)\n    guard Date.now.timeIntervalSince(modifiedAt) < 120 else { return nil }\n    systemPendingCommand = strdup(command)\n    return systemPendingCommand.map { UnsafePointer($0) }\n}"
                  }
                },
                "contextRegion": {
                  "startLine": 192,
                  "endLine": 207,
                  "snippet": {
                    "text": "@@ -0,1 +191,18 @@\n+/// 指针由原生层保管，调用方读取 UTF-8 字符串后不应释放。\n+@_cdecl(\"ci_system_integration_consume_pending\")\n+public func ci_system_integration_consume_pending() -> UnsafePointer<CChar>? {\n+    systemIntegrationLock.lock()\n+    defer { systemIntegrationLock.unlock() }\n+    free(systemPendingCommand)\n+    systemPendingCommand = nil\n+    guard let url = try? ClassIslandSystemSnapshotStore.fileURL(\n+        named: ClassIslandSystemSnapshotStore.pendingCommandFileName),\n+          let command = try? String(contentsOf: url, encoding: .utf8),\n+          let attributes = try? FileManager.default.attributesOfItem(atPath: url.path),\n+          let modifiedAt = attributes[.modificationDate] as? Date else { return nil }\n+    try? FileManager.default.removeItem(at: url)\n+    guard Date.now.timeIntervalSince(modifiedAt) < 120 else { return nil }\n+    systemPendingCommand = strdup(command)\n+    return systemPendingCommand.map { UnsafePointer($0) }\n+}\n+"
                  }
                }
              },
              "logicalLocations": [
                {
