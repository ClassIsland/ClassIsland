                "region": {
                  "startLine": 700,
                  "endLine": 720,
                  "snippet": {
                    "text": "@_cdecl(\"ci_live_activity_end\")\npublic func ci_live_activity_end(\n    _ dismissalPolicy: Int32,\n    _ completion: ClassIslandLiveActivityCompletion?,\n    _ context: UnsafeMutableRawPointer?\n) {\n    guard #available(iOS 16.1, *) else {\n        complete(\n            .failure(.unsupported, message: \"Live Activities require iOS 16.1 or later.\"),\n            using: completion,\n            context: context\n        )\n        return\n    }\n\n    ClassIslandLiveActivityCommandQueue.shared.end(\n        dismissalPolicy: dismissalPolicy,\n        completion: completion,\n        context: context\n    )"
                  }
                },
                "contextRegion": {
                  "startLine": 700,
                  "endLine": 720,
                  "snippet": {
                    "text": "@@ -0,1 +699,23 @@\n+\n+@_cdecl(\"ci_live_activity_end\")\n+public func ci_live_activity_end(\n+    _ dismissalPolicy: Int32,\n+    _ completion: ClassIslandLiveActivityCompletion?,\n+    _ context: UnsafeMutableRawPointer?\n+) {\n+    guard #available(iOS 16.1, *) else {\n+        complete(\n+            .failure(.unsupported, message: \"Live Activities require iOS 16.1 or later.\"),\n+            using: completion,\n+            context: context\n+        )\n+        return\n+    }\n+\n+    ClassIslandLiveActivityCommandQueue.shared.end(\n+        dismissalPolicy: dismissalPolicy,\n+        completion: completion,\n+        context: context\n+    )\n+}\n+"
                  }
                }
              },
