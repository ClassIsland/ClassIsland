          "message": {
            "text": "[提示] LaunchUrl — CPS=90.3% (C=88.3%, P=92.4%). 重复函数签名：`public Task LaunchUrl(string url)` 与上游 `LaunchUrl` (`ClassIsland.Android/Services/Platform/LauncherService.cs:L64-L68`) 冲突 修复: 建议直接复用或扩展 `ClassIsland.Android/Services/Platform/LauncherService.cs` 中的 `LaunchUrl`。",
            "markdown": "**提示** — `LaunchUrl` (`ClassIsland.Platforms.Abstractions/Services/SharedDocumentsLauncherService.cs:L32-L49`) · **CPS `90.3%`** (C `88.3%`, P `92.4%`, 权重 `0.1%`)\n- **问题:** 重复函数签名：`public Task LaunchUrl(string url)` 与上游 `LaunchUrl` (`ClassIsland.Android/Services/Platform/LauncherService.cs:L64-L68`) 冲突\n- **修复:** 建议直接复用或扩展 `ClassIsland.Android/Services/Platform/LauncherService.cs` 中的 `LaunchUrl`。"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "ClassIsland.Platforms.Abstractions/Services/SharedDocumentsLauncherService.cs",
                  "uriBaseId": "%SRCROOT%",
                  "index": 80
                },
                "region": {
                  "startLine": 32,
                  "endLine": 49,
                  "snippet": {
                    "text": "public Task LaunchUrl(string url)\n    {\n        ArgumentException.ThrowIfNullOrWhiteSpace(url);\n        if (!Uri.TryCreate(url, UriKind.Absolute, out var uri))\n        {\n            throw new ArgumentException(\"只能打开绝对 URL。\", nameof(url));\n        }\n\n        if (!string.Equals(uri.Scheme, Uri.UriSchemeHttp, StringComparison.OrdinalIgnoreCase) &&\n            !string.Equals(uri.Scheme, Uri.UriSchemeHttps, StringComparison.OrdinalIgnoreCase))\n        {\n            throw new ArgumentException(\n                \"iOS/iPadOS 仅支持通过 Safari 打开 HTTP(S) 链接。\",\n                nameof(url));\n        }\n\n        return OpenRequiredAsync(uri, $\"系统无法打开链接：{uri}\");\n    }"
                  }
                },
                "contextRegion": {
                  "startLine": 32,
                  "endLine": 49,
                  "snippet": {
                    "text": "@@ -0,1 +31,20 @@\n+\n+    public Task LaunchUrl(string url)\n+    {\n+        ArgumentException.ThrowIfNullOrWhiteSpace(url);\n+        if (!Uri.TryCreate(url, UriKind.Absolute, out var uri))\n+        {\n+            throw new ArgumentException(\"只能打开绝对 URL。\", nameof(url));\n+        }\n+\n+        if (!string.Equals(uri.Scheme, Uri.UriSchemeHttp, StringComparison.OrdinalIgnoreCase) &&\n+            !string.Equals(uri.Scheme, Uri.UriSchemeHttps, StringComparison.OrdinalIgnoreCase))\n+        {\n+            throw new ArgumentException(\n+                \"iOS/iPadOS 仅支持通过 Safari 打开 HTTP(S) 链接。\",\n+                nameof(url));\n+        }\n+\n+        return OpenRequiredAsync(uri, $\"系统无法打开链接：{uri}\");\n+    }\n+"
                  }
                }
              },
              "logicalLocations": [
